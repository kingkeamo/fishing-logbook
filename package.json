{
  "name": "fishing-logbook",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config src/FishingLogBook.Web/vitest.config.js",
    "test:watch": "vitest --config src/FishingLogBook.Web/vitest.config.js",
    "test:browser": "playwright test --config src/FishingLogBook.Web/BrowserTests/playwright.config.js",
    "test-local-browser": "playwright test --config src/FishingLogBook.Web/BrowserTests/playwright.config.js --project=chromium",
    "test-coverage": "vitest run --config src/FishingLogBook.Web/vitest.config.js --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
