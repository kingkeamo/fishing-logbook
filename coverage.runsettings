<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FishingLogBook.*]*</Include>
          <Exclude>[FishingLogBook.*.Tests]*,[FishingLogBook.Tests.Common]*</Exclude>
          <ExcludeByFile>**/obj/**/*,**/bin/**/*,**/*.g.cs,**/*.designer.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
