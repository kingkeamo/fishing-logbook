<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FishingLogBook.Db.Migrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    All SQL files under the numbered migration folders are embedded so DbUp can find them,
    and copied to the output directory for inspection/debugging.
  -->
  <ItemGroup>
    <EmbeddedResource Include="01_Tables\**\*.sql" />
    <EmbeddedResource Include="02_SeedData\**\*.sql" />
    <EmbeddedResource Include="03_Routines\**\*.sql" />
    <EmbeddedResource Include="04_Scripts\**\*.sql" />

    <Content Include="01_Tables\**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="02_SeedData\**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="03_Routines\**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="04_Scripts\**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
