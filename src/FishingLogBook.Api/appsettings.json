{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "ServiceUrl": "set in user secrets fishinglogbook-api",
    "BucketName": "fishing-logbook-dev",
    "AccessKeyId": "set in user secrets fishinglogbook-api",
    "SecretAccessKey": "set in user secrets fishinglogbook-api"
  },
  "Diagnostics": {
    "MaxBatchSize": 50,
    "MinimumLevel": "Warning"
  },
  "ExternalLogging": {
    "Provider": "None",
    "Environment": "unknown",
    "Url": "set in user secrets fishinglogbook-api",
    "User": "set in user secrets fishinglogbook-api",
    "ApiToken": "set in user secrets fishinglogbook-api"
  }
}
