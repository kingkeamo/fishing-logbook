@FishingLogBook.Api_HostAddress = http://localhost:5110

### System

GET {{FishingLogBook.Api_HostAddress}}/health
Accept: application/json

###

GET {{FishingLogBook.Api_HostAddress}}/api/system/database
Accept: application/json

GET {{FishingLogBook.Api_HostAddress}}/api/users/current
Accept: application/json
Authorization: Bearer <access-token>

### Profiles (requires a Cognito access token; never commit real tokens)

GET {{FishingLogBook.Api_HostAddress}}/api/profiles/me
Accept: application/json
Authorization: Bearer <access-token>

###

PUT {{FishingLogBook.Api_HostAddress}}/api/profiles/me
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "displayName": "Eamonn",
  "homeRegion": "Westmeath",
  "preferredFishingTypes": [ "Coarse" ],
  "preferredSpecies": [ "Pike" ],
  "showDisplayName": true,
  "showPhotograph": false,
  "showHomeRegion": true,
  "showPreferredFishingTypes": true,
  "showPreferredSpecies": false,
  "preferredWeightUnit": 0,
  "preferredLengthUnit": 0
}

###

GET {{FishingLogBook.Api_HostAddress}}/api/profiles/00000000-0000-0000-0000-000000000000
Accept: application/json
Authorization: Bearer <access-token>

###

POST {{FishingLogBook.Api_HostAddress}}/api/profiles/me/photograph/upload-url
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "photographId": "00000000-0000-0000-0000-000000000000",
  "contentType": "image/jpeg"
}

###

POST {{FishingLogBook.Api_HostAddress}}/api/profiles/me/photograph
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "photographId": "00000000-0000-0000-0000-000000000000",
  "objectKey": "profiles/00000000-0000-0000-0000-000000000000/00000000-0000-0000-0000-000000000000",
  "contentType": "image/jpeg"
}

### Catches (requires a Cognito access token; never commit real tokens)

POST {{FishingLogBook.Api_HostAddress}}/api/catches
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "id": "00000000-0000-0000-0000-000000000000",
  "caughtOn": "2026-08-17T08:00:00Z",
  "photographs": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "catchId": "00000000-0000-0000-0000-000000000000",
      "contentType": "image/jpeg"
    }
  ]
}

###

GET {{FishingLogBook.Api_HostAddress}}/api/catches/00000000-0000-0000-0000-000000000000
Accept: application/json
Authorization: Bearer <access-token>

###

PATCH {{FishingLogBook.Api_HostAddress}}/api/catches/00000000-0000-0000-0000-000000000000/location-visibility
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "visibility": "Private"
}

###

POST {{FishingLogBook.Api_HostAddress}}/api/catches/00000000-0000-0000-0000-000000000000/photographs/upload-url
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "photographId": "11111111-1111-1111-1111-111111111111",
  "contentType": "image/jpeg"
}

###

POST {{FishingLogBook.Api_HostAddress}}/api/catches/00000000-0000-0000-0000-000000000000/photographs
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "photographId": "11111111-1111-1111-1111-111111111111",
  "objectKey": "catches/22222222-2222-2222-2222-222222222222/00000000-0000-0000-0000-000000000000/11111111-1111-1111-1111-111111111111",
  "contentType": "image/jpeg"
}

###

### Fishing preferences (requires a Cognito access token; never commit real tokens)

GET {{FishingLogBook.Api_HostAddress}}/api/fishing-catalogue
Accept: application/json
Authorization: Bearer <access-token>

###

GET {{FishingLogBook.Api_HostAddress}}/api/profiles/me/fishing-preferences
Accept: application/json
Authorization: Bearer <access-token>

###

PUT {{FishingLogBook.Api_HostAddress}}/api/profiles/me/fishing-preferences
Accept: application/json
Content-Type: application/json
Authorization: Bearer <access-token>

{
  "methods": [
    {
      "fishingMethodId": "6cebaa41-de9c-4264-8034-03636b05f3c0",
      "isDefault": true,
      "species": [
        { "speciesId": "51e3798c-3d4d-438a-86fc-1b1ada032a83", "isDefault": true },
        { "speciesId": "628fcd12-1a16-43de-b5a5-6f8e344b33aa", "isDefault": false }
      ]
    }
  ]
}

