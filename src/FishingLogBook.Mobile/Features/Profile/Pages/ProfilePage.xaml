<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Profile.Models"
             xmlns:selectors="clr-namespace:FishingLogBook.Mobile.Features.Profile.Selectors"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Profile.ViewModels"
             x:Class="FishingLogBook.Mobile.Features.Profile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Text[Profile]}">
  <ContentPage.Resources>
    <DataTemplate x:Key="MoreChipTemplate" x:DataType="models:PreferenceMoreActionModel">
      <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[More]}"
              Clicked="OnMore" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
              MinimumHeightRequest="48" Padding="18,10" CornerRadius="24" AutomationId="ProfileMore" />
    </DataTemplate>
    <selectors:PreferenceChipTemplateSelector x:Key="MethodChipSelector" MoreTemplate="{StaticResource MoreChipTemplate}">
      <selectors:PreferenceChipTemplateSelector.ItemTemplate>
        <DataTemplate x:DataType="models:MethodPreferenceEditModel">
          <controls:SelectionPillView Margin="0,0,8,8"
                                      Label="{Binding Name}"
                                      IsSelected="{Binding IsSelected}"
                                      IsEnabled="{Binding IsEnabled}"
                                      SelectionRequested="OnMethodSelection" />
        </DataTemplate>
      </selectors:PreferenceChipTemplateSelector.ItemTemplate>
    </selectors:PreferenceChipTemplateSelector>
    <selectors:PreferenceChipTemplateSelector x:Key="SpeciesChipSelector" MoreTemplate="{StaticResource MoreChipTemplate}">
      <selectors:PreferenceChipTemplateSelector.ItemTemplate>
        <DataTemplate x:DataType="models:SpeciesPreferenceEditModel">
          <controls:SelectionPillView Margin="0,0,8,8"
                                      Label="{Binding Name}"
                                      IsSelected="True"
                                      IsDefault="{Binding IsDefault}"
                                      ShowDefaultIndicator="True"
                                      DefaultText="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileDefault]}"
                                      ShowRemoveAction="True"
                                      IsEnabled="{Binding IsEnabled}"
                                      DefaultDescription="{Binding DefaultDescription}"
                                      RemoveDescription="{Binding RemoveDescription}"
                                      DefaultRequested="OnSpeciesDefault"
                                      RemoveRequested="OnSpeciesRemove" />
        </DataTemplate>
      </selectors:PreferenceChipTemplateSelector.ItemTemplate>
    </selectors:PreferenceChipTemplateSelector>
  </ContentPage.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollView>
      <VerticalStackLayout Padding="16,12,16,24" Spacing="12" MaximumWidthRequest="720">
        <Label Text="{Binding Text[ProfileTitle]}" Style="{StaticResource Heading}" />
        <Label Text="{Binding Text[ProfileSubtitle]}" Style="{StaticResource SecondaryText}" Margin="0,-8,0,0" />
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" AutomationId="ProfileLoading" />
        <Border IsVisible="{Binding HasMessage}" Style="{StaticResource Card}" Padding="12" AutomationId="ProfileMessage">
          <VerticalStackLayout Spacing="8">
            <Label Text="{Binding Message}" Style="{StaticResource SecondaryText}" />
            <Button Text="{Binding Text[ProfileDiscardAndReload]}" IsVisible="{Binding IsSaveIncomplete}" IsEnabled="{Binding CanSave}"
                    Clicked="OnDiscardAndReload" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start"
                    AutomationId="ProfileDiscardAndReload" />
          </VerticalStackLayout>
        </Border>
        <VerticalStackLayout IsVisible="{Binding HasContent}" Spacing="12">
          <controls:ExpansionPanelView Title="{Binding Text[ProfileYourDetails]}" IsExpanded="True"
                                       ExpandHint="{Binding Text[SectionExpand]}" CollapseHint="{Binding Text[SectionCollapse]}"
                                       AutomationId="ProfileYourDetailsPanel">
            <VerticalStackLayout Spacing="12">
              <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                  <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                  <Image Source="brand_mark.png" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                  <Label Text="{Binding Text[ProfilePhotoPlaceholder]}" Style="{StaticResource SectionTitle}" />
                  <Label Text="{Binding Text[ProfilePhotoDeferred]}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
              </Grid>
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Text[ProfileDisplayName]}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource InputField}">
                  <Entry Text="{Binding DisplayName}" MaxLength="100" Style="{StaticResource FieldEntry}" AutomationId="ProfileDisplayName" />
                </Border>
              </VerticalStackLayout>
              <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="{Binding Text[ProfileShowDisplayName]}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowDisplayName}" AutomationId="ProfileShowDisplayName" />
              </Grid>
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Text[ProfileHomeRegion]}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource InputField}">
                  <Entry Text="{Binding HomeRegion}" MaxLength="200" Style="{StaticResource FieldEntry}" AutomationId="ProfileHomeRegion" />
                </Border>
              </VerticalStackLayout>
              <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="{Binding Text[ProfileShowHomeRegion]}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowHomeRegion}" AutomationId="ProfileShowHomeRegion" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="{Binding Text[ProfileShowPhoto]}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowPhotograph}" AutomationId="ProfileShowPhoto" />
              </Grid>
            </VerticalStackLayout>
          </controls:ExpansionPanelView>

          <controls:ExpansionPanelView Title="{Binding Text[ProfileFishingDetails]}"
                                       ExpandHint="{Binding Text[SectionExpand]}" CollapseHint="{Binding Text[SectionCollapse]}"
                                       AutomationId="ProfileFishingDetailsPanel">
            <VerticalStackLayout Spacing="12">
              <Label Text="{Binding Text[ProfileMethods]}" Style="{StaticResource SectionTitle}" />
              <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                          BindableLayout.ItemsSource="{Binding MethodChipItems}"
                          BindableLayout.ItemTemplateSelector="{StaticResource MethodChipSelector}"
                          AutomationId="ProfileMethods" />

              <Label Text="{Binding Text[ProfileSetDefaultMethod]}" Style="{StaticResource SecondaryText}" />
              <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                          BindableLayout.ItemsSource="{Binding SelectedMethods}" AutomationId="ProfileDefaultMethods">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="models:MethodPreferenceEditModel">
                    <controls:SelectionPillView Margin="0,0,8,8"
                                                Label="{Binding Name}"
                                                IsSelected="True"
                                                IsDefault="{Binding IsDefault}"
                                                ShowDefaultIndicator="True"
                                                DefaultText="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileDefault]}"
                                                IsEnabled="{Binding IsEnabled}"
                                                DefaultDescription="{Binding DefaultDescription}"
                                                DefaultRequested="OnMethodDefault" />
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </FlexLayout>

              <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedMethods}" Spacing="12">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="models:MethodPreferenceEditModel">
                    <VerticalStackLayout Spacing="6">
                      <BoxView Style="{StaticResource Divider}" Margin="0,0,0,6" />
                      <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                      <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileSetDefaultSpecies]}" Style="{StaticResource SecondaryText}" />
                      <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                                  BindableLayout.ItemsSource="{Binding SpeciesChipItems}"
                                  BindableLayout.ItemTemplateSelector="{StaticResource SpeciesChipSelector}" />
                    </VerticalStackLayout>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>

              <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="{Binding Text[ProfileShowMethods]}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowPreferredFishingMethods}" AutomationId="ProfileShowMethods" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Label Text="{Binding Text[ProfileShowSpecies]}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowPreferredSpecies}" AutomationId="ProfileShowSpecies" />
              </Grid>
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Text[ProfileWeightUnit]}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource InputField}">
                  <Picker ItemsSource="{Binding WeightUnitOptions}"
                          ItemDisplayBinding="{Binding Label, x:DataType={x:Null}}"
                          SelectedItem="{Binding SelectedWeightUnit}" AutomationId="ProfileWeightUnit" />
                </Border>
              </VerticalStackLayout>
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Text[ProfileLengthUnit]}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource InputField}">
                  <Picker ItemsSource="{Binding LengthUnitOptions}"
                          ItemDisplayBinding="{Binding Label, x:DataType={x:Null}}"
                          SelectedItem="{Binding SelectedLengthUnit}" AutomationId="ProfileLengthUnit" />
                </Border>
              </VerticalStackLayout>

              <BoxView Style="{StaticResource Divider}" />
              <Label Text="{Binding Text[ProfileLocations]}" Style="{StaticResource SectionTitle}" />
              <Label Text="{Binding Text[ProfileLocationsHint]}" Style="{StaticResource SecondaryText}" Margin="0,-8,0,0" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource InputField}">
                  <Entry x:Name="NewLocation" Placeholder="{Binding Text[ProfileLocationName]}" MaxLength="200" Style="{StaticResource FieldEntry}" AutomationId="ProfileNewLocation" />
                </Border>
                <Button Grid.Column="1" Text="{Binding Text[Add]}" Clicked="OnAddLocation" Style="{StaticResource SecondaryButton}" AutomationId="ProfileAddLocation" />
              </Grid>
              <VerticalStackLayout BindableLayout.ItemsSource="{Binding Locations}" Spacing="8" AutomationId="ProfileLocations">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="models:FishingLocationEditModel">
                    <Grid ColumnDefinitions="*,44,44" ColumnSpacing="2">
                      <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Name}" MaxLength="200" Style="{StaticResource FieldEntry}" Unfocused="OnLocationRenamed" />
                      </Border>
                      <Grid Grid.Column="1" HeightRequest="44" SemanticProperties.Description="{Binding Name}"
                            SemanticProperties.Hint="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[SetAsDefault]}">
                        <Grid.GestureRecognizers>
                          <TapGestureRecognizer Tapped="OnLocationDefault" />
                        </Grid.GestureRecognizers>
                        <Label Text="☆" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDefault}" Value="True">
                              <Setter Property="Text" Value="★" />
                              <Setter Property="TextColor" Value="{StaticResource PreferenceDefault}" />
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                      </Grid>
                      <Grid Grid.Column="2" HeightRequest="44" SemanticProperties.Description="{Binding Name}"
                            SemanticProperties.Hint="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[Remove]}">
                        <Grid.GestureRecognizers>
                          <TapGestureRecognizer Tapped="OnRemoveLocation" />
                        </Grid.GestureRecognizers>
                        <controls:IconView Source="icon_trash.png" Tone="Danger" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>
            </VerticalStackLayout>
          </controls:ExpansionPanelView>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
    <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource DarkSurface}}" Padding="16,10,16,14">
      <Button Text="{Binding Text[ProfileSave]}" IsEnabled="{Binding CanSave}" Clicked="OnSave" AutomationId="ProfileSave" />
    </Border>
  </Grid>
</ContentPage>
