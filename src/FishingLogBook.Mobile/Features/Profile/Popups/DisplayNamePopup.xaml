<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="FishingLogBook.Mobile.Features.Profile.Popups.DisplayNamePopup"
               x:TypeArguments="x:Boolean"
               Padding="0" Margin="16,72,16,0" VerticalOptions="Start" HorizontalOptions="End"
               BackgroundColor="Transparent">
  <Border StrokeThickness="0" Padding="16,10"
          BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource DarkSurface}}">
    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
    <Label x:Name="NameLabel" Style="{StaticResource BodyText}" FontAttributes="Bold"
           AutomationId="HeaderProfileDisplayName" />
  </Border>
</toolkit:Popup>
