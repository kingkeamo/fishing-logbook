<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Photographs.ViewModels"
             xmlns:views="clr-namespace:FishingLogBook.Mobile.Features.Photographs.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FishingLogBook.Mobile.Features.Photographs.Views.PhotoCollectionEditorView" x:Name="Root">
  <toolkit:Expander BindingContext="{Binding ViewModel, Source={x:Reference Root}, x:DataType=views:PhotoCollectionEditorView}"
                    x:DataType="vm:PhotographCollectionEditorViewModel" IsExpanded="True" x:Name="PhotoPanel">
    <toolkit:Expander.Header>
      <Grid ColumnDefinitions="*,48" MinimumHeightRequest="48" AutomationId="PhotoSectionToggle">
        <Label Text="{Binding Text[Photos]}" Style="{StaticResource TileCaption}" VerticalOptions="Center" />
        <Label Grid.Column="1" Text="⌃" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsExpanded, Source={x:Reference PhotoPanel}, x:DataType=toolkit:Expander}" Value="False">
              <Setter Property="Text" Value="⌄" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </Grid>
    </toolkit:Expander.Header>
    <toolkit:Expander.Content>
      <VerticalStackLayout Spacing="12">
    <views:PhotoCarouselView PhotoPath="{Binding CurrentPhotograph.PreviewPath}" PositionText="{Binding PositionText}"
                             Text="{Binding Text}" HasMultiplePhotographs="{Binding HasMultiplePhotographs}"
                             IsVisible="{Binding HasItems}" IsEditable="True" CanRemove="{Binding CanRemove}"
                             PreviousRequested="OnPrevious" NextRequested="OnNext" RemoveRequested="OnRemoveCurrent" />
    <views:PhotoDetailsView CapturedOnText="{Binding CapturedOnText}" LocationText="{Binding LocationText}"
                           Text="{Binding Text}" IsVisible="{Binding HasItems}" CanUseDetails="{Binding CanUseDetails}"
                           IsChosen="{Binding IsCurrentDetailsApplied}" UseDetailsRequested="OnUseDetails"
                           ShowUseDetails="{Binding ShowUseDetails, Source={x:Reference Root}, x:DataType=views:PhotoCollectionEditorView}" />
    <views:PhotoPickerView Text="{Binding Text}" CanAddMore="{Binding CanAddMore}" IsBusy="{Binding IsBusy}"
                          HasStatus="{Binding HasStatus}" StatusText="{Binding StatusText}"
                          TakePhotoRequested="OnTakePhoto" ChooseGalleryRequested="OnChooseGallery" />
      </VerticalStackLayout>
    </toolkit:Expander.Content>
  </toolkit:Expander>
</ContentView>
