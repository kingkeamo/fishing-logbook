<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:text="clr-namespace:FishingLogBook.Mobile.Localization" x:Class="FishingLogBook.Mobile.Features.Showcase.Pages.ShowcasePage"
 x:DataType="text:UiTextService" Title="{Binding [Showcase]}">
 <ScrollView><VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMedium}" MaximumWidthRequest="720">
  <Label Text="{Binding [ShowcaseBody]}" Style="{StaticResource SecondaryText}" />
  <Button Text="{Binding [OpenControlsShowcase]}" Clicked="OnOpenControls" AutomationId="OpenControlsShowcase" />
  <Label Text="{Binding [Interactions]}" Style="{StaticResource Subheading}" />
  <Button Text="{Binding [Success]}" CommandParameter="Success" Clicked="OnNotify" AutomationId="NotifySuccess" />
  <Button Text="{Binding [Info]}" CommandParameter="Info" Clicked="OnNotify" Style="{StaticResource SecondaryButton}" AutomationId="NotifyInfo" />
  <Button Text="{Binding [Warning]}" CommandParameter="Warning" Clicked="OnNotify" Style="{StaticResource SecondaryButton}" AutomationId="NotifyWarning" />
  <Button Text="{Binding [Error]}" CommandParameter="Error" Clicked="OnNotify" Style="{StaticResource SecondaryButton}" AutomationId="NotifyError" />
  <Button Text="{Binding [ConfirmDemo]}" Clicked="OnConfirm" Style="{StaticResource SecondaryButton}" AutomationId="ConfirmDemo" />
  <Button Text="{Binding [ModalDemo]}" Clicked="OnModal" Style="{StaticResource SecondaryButton}" AutomationId="ModalDemo" />
  <Button Text="{Binding [CancelModalDemo]}" Clicked="OnCancelModal" Style="{StaticResource SecondaryButton}" AutomationId="CancelModalDemo" />
  <Label Text="{Binding [States]}" Style="{StaticResource Subheading}" />
  <Button Text="{Binding [SimulateLoading]}" CommandParameter="Loading" Clicked="OnState" AutomationId="StateLoading" Style="{StaticResource SecondaryButton}" />
  <Button Text="{Binding [SimulateEmpty]}" CommandParameter="Empty" Clicked="OnState" AutomationId="StateEmpty" Style="{StaticResource SecondaryButton}" />
  <Button Text="{Binding [SimulateError]}" CommandParameter="Error" Clicked="OnState" AutomationId="StateError" Style="{StaticResource SecondaryButton}" />
  <Button Text="{Binding [SimulateOffline]}" CommandParameter="Offline" Clicked="OnState" AutomationId="StateOffline" Style="{StaticResource SecondaryButton}" />
  <Button Text="{Binding [ResetStates]}" CommandParameter="Ready" Clicked="OnState" AutomationId="StateReady" />
 </VerticalStackLayout></ScrollView>
</ContentPage>
