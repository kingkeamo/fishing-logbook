<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:viewModels="clr-namespace:FishingLogBook.Mobile.Features.Authentication.ViewModels"
 x:Class="FishingLogBook.Mobile.Features.Authentication.Pages.AuthenticationPage"
 x:DataType="viewModels:AuthenticationViewModel"
 BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}"
 Shell.NavBarIsVisible="False">
 <ScrollView>
  <VerticalStackLayout Padding="24,48,24,32" Spacing="20" MaximumWidthRequest="520" VerticalOptions="Center">
   <Image Source="brand_horizontal.png" HeightRequest="72" Aspect="AspectFit"
    SemanticProperties.Description="{Binding Text[Brand]}" />
   <Label Text="{Binding Text[SignInTitle]}" Style="{StaticResource Heading}"
    HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1" />
   <Label Text="{Binding Text[SignInBody]}" Style="{StaticResource SecondaryText}"
    HorizontalTextAlignment="Center" />
   <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
    SemanticProperties.Description="{Binding Text[RestoringSession]}" />
   <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Style="{StaticResource SecondaryText}"
    HorizontalTextAlignment="Center" AutomationId="AuthenticationStatus" />
   <Button Text="{Binding Text[SignIn]}" IsEnabled="{Binding CanSignIn}" HeightRequest="52"
    Clicked="OnSignIn" AutomationId="SignIn"
    SemanticProperties.Description="{Binding Text[SignInBody]}" />
   <Button Text="{Binding Text[CancelSignIn]}" IsVisible="{Binding IsPending}"
    IsEnabled="{Binding CanCancel}" HeightRequest="52" Style="{StaticResource SecondaryButton}"
    Clicked="OnCancel" AutomationId="CancelSignIn"
    SemanticProperties.Description="{Binding Text[CancelSignIn]}" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
