<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Import.Models"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Import.ViewModels"
             x:Class="FishingLogBook.Mobile.Features.Import.Pages.ImportPage"
             x:Name="Root"
             x:DataType="vm:ImportViewModel"
             Title="{Binding Text[Import_PageTitle]}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
  <controls:WizardStepperView CurrentStep="{Binding StepNumber}"
                              StepCount="{Binding StepCount}"
                              StepLabel="{Binding StepLabel}"
                              Title="{Binding StepTitle}"
                              Description="{Binding StepDescription}"
                              BackText="{Binding Text[Back]}"
                              ContinueText="{Binding ContinueText}"
                              CanGoBack="{Binding CanGoBack}"
                              CanContinue="{Binding CanContinue}"
                              IsBusy="{Binding IsBusy}"
                              BackRequested="OnBack"
                              ContinueRequested="OnContinue">
    <VerticalStackLayout Spacing="16">
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         Color="{StaticResource Primary}" AutomationId="ImportLoading" />
      <Border IsVisible="{Binding HasMessage}" Style="{StaticResource Card}" Padding="12" AutomationId="ImportMessage">
        <Label Text="{Binding Message}" Style="{StaticResource SecondaryText}"
               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
      </Border>
      <Label Text="{Binding ContinueHint}" IsVisible="{Binding HasContinueHint}" Style="{StaticResource SecondaryText}"
             AutomationId="ImportContinueHint" />

      <VerticalStackLayout IsVisible="{Binding IsBatchStep}" Spacing="12" AutomationId="ImportBatchDetails">
        <Label Text="{Binding Text[Import_FishingMethod]}" Style="{StaticResource Eyebrow}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding MethodOptions}" AutomationId="ImportMethodChips">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:ImportOptionModel">
              <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                 CommandParameter="{Binding}" Tapped="OnMethodChip" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
        <Label Text="{Binding Text[Import_Species]}" Style="{StaticResource Eyebrow}" />
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SpeciesOptions}" AutomationId="ImportSpeciesChips">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:ImportOptionModel">
              <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                 CommandParameter="{Binding}" Tapped="OnSpeciesChip" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
      </VerticalStackLayout>

      <VerticalStackLayout IsVisible="{Binding IsPhotosStep}" Spacing="12" AutomationId="ImportChoosePhotos">
        <Button Text="{Binding Text[Import_ChoosePhotosTitle]}" Clicked="OnPickPhotos"
                AutomationId="ImportPickPhotos" />
        <Label Text="{Binding Text[Import_ProcessingPhotos]}" IsVisible="{Binding IsBusy}"
               Style="{StaticResource SecondaryText}" AutomationId="ImportProcessing" />
        <Label Text="{Binding SelectionLimitText}" IsVisible="{Binding SelectionLimitExceeded}"
               Style="{StaticResource SecondaryText}"
               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
               AutomationId="ImportSelectionLimit" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Photos}" Spacing="10">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:ImportPhotoRowModel">
              <Border Style="{StaticResource Card}" Padding="12">
                <VerticalStackLayout Spacing="8">
                  <Grid ColumnDefinitions="72,* ,40" ColumnSpacing="12">
                    <Image Source="{Binding Photo.ThumbnailUrl}" Aspect="AspectFill" HeightRequest="72"
                           IsVisible="{Binding Photo.IsReady}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                      <Label Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" />
                      <Label Text="{Binding DuplicateText}" IsVisible="{Binding HasWarning}"
                             Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                            CommandParameter="{Binding Photo.Id}" Clicked="OnRemovePhoto"
                            SemanticProperties.Description="{Binding BindingContext.Text[Import_RemovePhoto], Source={x:Reference Root}}"
                            AutomationId="ImportRemovePhoto" />
                  </Grid>
                  <VerticalStackLayout IsVisible="{Binding RequiresDuplicateDecision}" Spacing="8">
                    <Label Text="{Binding DuplicateText}" Style="{StaticResource SecondaryText}" />
                    <HorizontalStackLayout Spacing="8">
                      <Button Text="{Binding BindingContext.Text[Import_DuplicateRemove], Source={x:Reference Root}}"
                              Style="{StaticResource SecondaryButton}" CommandParameter="{Binding Photo.Id}"
                              Clicked="OnRemovePhoto" AutomationId="ImportRemoveDuplicate" />
                      <Button Text="{Binding BindingContext.Text[Import_DuplicateKeepBoth], Source={x:Reference Root}}"
                              CommandParameter="{Binding Photo.Id}" Clicked="OnKeepDuplicate"
                              AutomationId="ImportKeepDuplicate" />
                    </HorizontalStackLayout>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>

      <VerticalStackLayout IsVisible="{Binding IsCatchReviewStep}" Spacing="12" AutomationId="ImportCatchReview">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Catches}" Spacing="12">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:ImportCatchRowModel">
              <Border Style="{StaticResource Card}" Padding="12">
                <VerticalStackLayout Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Title}" Style="{StaticResource Subheading}" />
                    <Label Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                           AutomationId="ImportCatchStatus" />
                  </Grid>
                  <Button Text="{Binding BindingContext.Text[Import_ConfirmCatch], Source={x:Reference Root}}"
                          IsEnabled="{Binding CanConfirm}" CommandParameter="{Binding Proposal.Id}"
                          Clicked="OnConfirmCatch" AutomationId="ImportConfirmCatch" />
                  <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Photos}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportCatchPhotoModel">
                        <VerticalStackLayout Margin="0,0,8,8" WidthRequest="88" Spacing="4">
                          <Border StrokeThickness="2" HeightRequest="88" WidthRequest="88"
                                  Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource DarkSurface}}"
                                  AutomationId="ImportCatchPhoto">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.Triggers>
                              <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                              </DataTrigger>
                            </Border.Triggers>
                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" InputTransparent="True"
                                   IsVisible="{Binding HasThumbnail}" />
                            <Border.GestureRecognizers>
                              <TapGestureRecognizer Tapped="OnToggleCatchPhoto" />
                            </Border.GestureRecognizers>
                          </Border>
                          <Label Text="{Binding Label}" Style="{StaticResource SecondaryText}"
                                 HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                  <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowPhotoActions}">
                    <Button Text="{Binding BindingContext.Text[Import_MoveToNewCatch], Source={x:Reference Root}}"
                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanSplit}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnSplitCatch"
                            AutomationId="ImportSplitCatch" />
                    <Button Text="{Binding BindingContext.Text[Import_RemoveSelectedPhotos], Source={x:Reference Root}}"
                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanRemoveSelected}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnRemoveSelectedPhotos"
                            AutomationId="ImportRemoveSelectedPhotos" />
                  </HorizontalStackLayout>
                  <Label Text="{Binding TimestampText}" Style="{StaticResource SecondaryText}" />
                  <Label Text="{Binding BindingContext.Text[Import_CaughtOn], Source={x:Reference Root}}"
                         Style="{StaticResource Eyebrow}" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <DatePicker Date="{Binding CaughtOnDate}" Format="{Binding DateFormat}"
                                DateSelected="OnCaughtOnDateChanged" AutomationId="ImportCaughtOnDate" />
                    <TimePicker Grid.Column="1" Time="{Binding CaughtOnTime}" Format="{Binding TimeFormat}"
                                PropertyChanged="OnCaughtOnTimeChanged" AutomationId="ImportCaughtOnTime" />
                  </Grid>
                  <Label Text="{Binding BindingContext.Text[Import_MergeValuesNeedReview], Source={x:Reference Root}}"
                         IsVisible="{Binding NeedsCanonicalReview}" Style="{StaticResource SecondaryText}" />
                  <Button Text="{Binding BindingContext.Text[Import_UseShownValues], Source={x:Reference Root}}"
                          IsVisible="{Binding NeedsCanonicalReview}" CommandParameter="{Binding Proposal.Id}"
                          Clicked="OnUseShownValues" AutomationId="ImportUseShownValues" />
                  <Label Text="{Binding BindingContext.Text[Import_FishingMethod], Source={x:Reference Root}}"
                         Style="{StaticResource Eyebrow}" />
                  <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding MethodOptions}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportOptionModel">
                        <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                           CommandParameter="{Binding}" Tapped="OnCatchMethodChip" />
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                  <Label Text="{Binding BindingContext.Text[Import_Species], Source={x:Reference Root}}"
                         Style="{StaticResource Eyebrow}" />
                  <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SpeciesOptions}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportOptionModel">
                        <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                           CommandParameter="{Binding}" Tapped="OnCatchSpeciesChip" />
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="{Binding WeightText}" Style="{StaticResource SecondaryButton}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnEditWeight"
                            SemanticProperties.Description="{Binding BindingContext.Text[MeasureWeight], Source={x:Reference Root}}"
                            AutomationId="ImportCatchWeight" />
                    <Button Grid.Column="1" Text="{Binding LengthText}" Style="{StaticResource SecondaryButton}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnEditLength"
                            SemanticProperties.Description="{Binding BindingContext.Text[MeasureLength], Source={x:Reference Root}}"
                            AutomationId="ImportCatchLength" />
                  </Grid>
                  <Label Text="{Binding LocationText}" Style="{StaticResource SecondaryText}" />
                  <Label Text="{Binding LocationHelp}" IsVisible="{Binding HasLocationHelp}"
                         Style="{StaticResource SecondaryText}" AutomationId="ImportLocationHelp" />
                  <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding BindingContext.Text[Import_Edit], Source={x:Reference Root}}"
                            Style="{StaticResource SecondaryButton}" IsVisible="{Binding CanEditPlaceName}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnEditPlaceName"
                            AutomationId="ImportEditPlaceName" />
                    <Button Text="{Binding BindingContext.Text[Import_RemoveLocation], Source={x:Reference Root}}"
                            Style="{StaticResource SecondaryButton}" IsVisible="{Binding CanRemoveLocation}"
                            CommandParameter="{Binding Proposal.Id}" Clicked="OnRemoveLocation"
                            AutomationId="ImportRemoveLocation" />
                  </HorizontalStackLayout>
                  <VerticalStackLayout IsVisible="{Binding HasLocationChoices}" Spacing="8"
                                       BindableLayout.ItemsSource="{Binding Locations}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportLocationChoiceModel">
                        <Button Text="{Binding Label}" Style="{StaticResource SecondaryButton}"
                                CommandParameter="{Binding}" Clicked="OnAcceptLocation"
                                AutomationId="ImportAcceptLocation" />
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
                  <Label Text="{Binding BindingContext.Text[Import_MergeWith], Source={x:Reference Root}}"
                         IsVisible="{Binding HasMergeTargets}" Style="{StaticResource Eyebrow}" />
                  <FlexLayout Wrap="Wrap" IsVisible="{Binding HasMergeTargets}"
                              BindableLayout.ItemsSource="{Binding MergeTargets}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportMergeTargetModel">
                        <Button Margin="0,0,8,8" Text="{Binding Label}" Style="{StaticResource SecondaryButton}"
                                CommandParameter="{Binding}" Clicked="OnMergeCatch"
                                AutomationId="ImportMergeCatch" />
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                  <Button Text="{Binding BindingContext.Text[Import_RemoveCatch], Source={x:Reference Root}}"
                          Style="{StaticResource SecondaryButton}" CommandParameter="{Binding Proposal.Id}"
                          Clicked="OnRemoveCatch" AutomationId="ImportRemoveCatch" />
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>

      <VerticalStackLayout IsVisible="{Binding IsTripReviewStep}" Spacing="12" AutomationId="ImportTripReview">
        <Label Text="{Binding Text[Import_NoTripSuggestions]}" IsVisible="{Binding HasNoTrips}"
               Style="{StaticResource SecondaryText}" AutomationId="ImportNoTrips" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trips}" Spacing="12">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:ImportTripRowModel">
              <Border Style="{StaticResource Card}" Padding="12">
                <VerticalStackLayout Spacing="10">
                  <Label Text="{Binding Title}" Style="{StaticResource Subheading}" />
                  <Label Text="{Binding RangeText}" Style="{StaticResource SecondaryText}" />
                  <Label Text="{Binding MissingGpsText}" IsVisible="{Binding HasMissingGps}"
                         Style="{StaticResource SecondaryText}" />
                  <Label Text="{Binding BindingContext.Text[Import_ExistingTripFound], Source={x:Reference Root}}"
                         IsVisible="{Binding HasExistingTrips}" Style="{StaticResource SecondaryText}" />
                  <Label Text="{Binding DecisionText}" IsVisible="{Binding HasDecision}"
                         Style="{StaticResource SecondaryText}" AutomationId="ImportTripDecision" />
                  <Button Text="{Binding CreateText}" CommandParameter="{Binding Proposal.Id}"
                          Clicked="OnCreateTrip" AutomationId="ImportCreateTrip">
                    <Button.Triggers>
                      <DataTrigger TargetType="Button" Binding="{Binding IsCreateNew}" Value="False">
                        <Setter Property="Style" Value="{StaticResource SecondaryButton}" />
                      </DataTrigger>
                    </Button.Triggers>
                  </Button>
                  <Button Text="{Binding BindingContext.Text[Import_KeepSeparate], Source={x:Reference Root}}"
                          CommandParameter="{Binding Proposal.Id}" Clicked="OnKeepSeparate"
                          AutomationId="ImportKeepSeparate">
                    <Button.Triggers>
                      <DataTrigger TargetType="Button" Binding="{Binding IsKeepSeparate}" Value="False">
                        <Setter Property="Style" Value="{StaticResource SecondaryButton}" />
                      </DataTrigger>
                    </Button.Triggers>
                  </Button>
                  <Button Text="{Binding BindingContext.Text[Import_AddToExistingTrip], Source={x:Reference Root}}"
                          IsVisible="{Binding HasExistingTrips}" CommandParameter="{Binding Proposal.Id}"
                          Clicked="OnUseExistingTrip" AutomationId="ImportUseExistingTrip">
                    <Button.Triggers>
                      <DataTrigger TargetType="Button" Binding="{Binding IsUseExisting}" Value="False">
                        <Setter Property="Style" Value="{StaticResource SecondaryButton}" />
                      </DataTrigger>
                    </Button.Triggers>
                  </Button>
                  <VerticalStackLayout IsVisible="{Binding ShowParticipants}" Spacing="8"
                                       AutomationId="ImportTripParticipants">
                    <Label Text="{Binding BindingContext.Text[Import_TripParticipants], Source={x:Reference Root}}"
                           Style="{StaticResource Subheading}" FontSize="15" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Participants}">
                      <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ImportTripParticipantModel">
                          <HorizontalStackLayout Spacing="0" Margin="0,0,8,8">
                            <controls:ChipView Text="{Binding Name}" MaximumWidthRequest="220" />
                            <Button Text="&#x00D7;" Style="{StaticResource SecondaryButton}" WidthRequest="48"
                                    MinimumHeightRequest="48" Padding="0" CommandParameter="{Binding}"
                                    Clicked="OnRemoveTripParticipant"
                                    SemanticProperties.Description="{Binding BindingContext.Text[TripRemoveParticipant], Source={x:Reference Root}}"
                                    AutomationId="ImportRemoveTripParticipant" />
                          </HorizontalStackLayout>
                        </DataTemplate>
                      </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Button Text="{Binding BindingContext.Text[Import_AddTripParticipant], Source={x:Reference Root}}"
                            Style="{StaticResource SecondaryButton}" CommandParameter="{Binding Proposal.Id}"
                            Clicked="OnAddTripParticipant" AutomationId="ImportAddTripParticipant" />
                  </VerticalStackLayout>
                  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Catches}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportTripCatchModel">
                        <Grid ColumnDefinitions="*,Auto">
                          <Label Text="{Binding Title}" VerticalOptions="Center" />
                          <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" BorderWidth="0"
                                  CommandParameter="{Binding}" Clicked="OnRemoveCatchFromTrip"
                                  SemanticProperties.Description="{Binding BindingContext.Text[Import_RemoveCatchFromTrip], Source={x:Reference Root}}"
                                  AutomationId="ImportRemoveCatchFromTrip" />
                        </Grid>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>

      <VerticalStackLayout IsVisible="{Binding IsConfirmStep}" Spacing="12" AutomationId="ImportConfirm">
        <Label Text="{Binding Text[Import_ConfirmationBoundary]}" Style="{StaticResource SecondaryText}" />
        <Label Text="{Binding SummaryCatches}" AutomationId="ImportSummaryCatches" />
        <Label Text="{Binding SummaryPhotos}" AutomationId="ImportSummaryPhotos" />
        <Label Text="{Binding SummaryNewTrips}" AutomationId="ImportSummaryNewTrips" />
        <Label Text="{Binding SummaryExistingTrips}" AutomationId="ImportSummaryExistingTrips" />
        <Label Text="{Binding SummaryStandalone}" AutomationId="ImportSummaryStandalone" />
        <Label Text="{Binding ProgressText}" IsVisible="{Binding IsPersisting}" Style="{StaticResource SecondaryText}"
               AutomationId="ImportProgress" />
        <Button Text="{Binding Text[Cancel]}" Style="{StaticResource SecondaryButton}"
                IsVisible="{Binding IsPersisting}" Clicked="OnCancelPersistence"
                AutomationId="ImportCancelPersistence" />
      </VerticalStackLayout>

      <VerticalStackLayout IsVisible="{Binding IsSuccessStep}" Spacing="12" AutomationId="ImportSuccess">
        <Button Text="{Binding Text[Import_ViewTrips]}" Style="{StaticResource SecondaryButton}"
                Clicked="OnViewTrips" AutomationId="ImportViewTrips" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </controls:WizardStepperView>
</ContentPage>
