<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Dashboard.ViewModels"
 xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Dashboard.Models"
 xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
 x:Class="FishingLogBook.Mobile.Features.Dashboard.Pages.DashboardPage"
 x:DataType="vm:DashboardViewModel" Title="{Binding Text[Dashboard]}" Shell.NavBarIsVisible="False">
 <ContentPage.Resources>
  <DataTemplate x:Key="BestRow" x:DataType="models:DashboardRowModel">
   <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" MinimumHeightRequest="48" Padding="0,4">
    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenRow" CommandParameter="{Binding CatchId}" /></Grid.GestureRecognizers>
    <Label Text="{Binding Species}" Style="{StaticResource BodyText}" VerticalOptions="Center" LineBreakMode="WordWrap" />
    <Label Grid.Column="1" Text="{Binding Method}" Style="{StaticResource SecondaryText}" VerticalOptions="Center" LineBreakMode="WordWrap" />
    <Button Grid.Column="2" Text="{Binding Value}" CommandParameter="{Binding CatchId}" Clicked="OnOpenCatch"
            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            MinimumHeightRequest="48" Padding="8" SemanticProperties.Description="{Binding Description}" AutomationId="DashboardBestOpen" />
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CountRow" x:DataType="models:DashboardRowModel">
   <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" MinimumHeightRequest="44" Padding="0,4">
    <Label Text="{Binding Species}" Style="{StaticResource BodyText}" VerticalOptions="Center" LineBreakMode="WordWrap" />
    <Label Grid.Column="1" Text="{Binding Method}" Style="{StaticResource SecondaryText}" VerticalOptions="Center" LineBreakMode="WordWrap" />
    <Label Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Subheading}" VerticalOptions="Center" />
   </Grid>
  </DataTemplate>
 </ContentPage.Resources>
 <ScrollView>
  <VerticalStackLayout Spacing="14" Padding="16,12,16,28" MaximumWidthRequest="800" HorizontalOptions="Fill">
   <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8">
    <ImageButton Source="icon_menu.png" Clicked="OnOpenMenu" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48"
                 SemanticProperties.Description="{Binding Text[OpenMenu]}" AutomationId="DashboardMenu" />
    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
     <Label Text="{Binding Text[Dashboard]}" Style="{StaticResource Heading}" AutomationId="DashboardHeading" />
     <Label Text="{Binding Text[DashboardSubtitle]}" Style="{StaticResource SecondaryText}" />
    </VerticalStackLayout>
   </Grid>
   <Button Text="{Binding Text[DashboardRecord]}" Style="{StaticResource PrimaryButton}" Clicked="OnRecordCatch" AutomationId="DashboardRecordCatch" />
   <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" SemanticProperties.Description="{Binding Text[DashboardLoading]}" AutomationId="DashboardLoading" />
   <Border Style="{StaticResource Card}" IsVisible="{Binding HasStatus}" Padding="12" Shadow="{x:Null}" AutomationId="DashboardStatus">
    <VerticalStackLayout Spacing="8">
     <Label Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
     <Button Text="{Binding Text[DashboardRetry]}" Style="{StaticResource SecondaryButton}" Clicked="OnApply" IsEnabled="{Binding CanApply}" />
    </VerticalStackLayout>
   </Border>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" AutomationId="DashboardLifetime">
    <Border Style="{StaticResource Card}" Padding="10" Shadow="{x:Null}">
     <VerticalStackLayout Spacing="4">
      <Label Text="{Binding CatchesTotal}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="DashboardCatchesTotal" />
      <Label Text="{Binding Text[DashboardCatches]}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
     </VerticalStackLayout>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Shadow="{x:Null}">
     <VerticalStackLayout Spacing="4">
      <Label Text="{Binding TripsTotal}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="DashboardTripsTotal" />
      <Label Text="{Binding Text[DashboardTrips]}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
     </VerticalStackLayout>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10" Shadow="{x:Null}">
     <VerticalStackLayout Spacing="4">
      <Label Text="{Binding SpeciesTotal}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="DashboardSpeciesTotal" />
      <Label Text="{Binding Text[DashboardSpecies]}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
     </VerticalStackLayout>
    </Border>
   </Grid>
   <Border Style="{StaticResource Card}" Padding="14" Shadow="{x:Null}" AutomationId="DashboardAllTimeBests">
     <VerticalStackLayout Spacing="8">
      <Label Text="{Binding Text[DashboardAllTimeBests]}" Style="{StaticResource Subheading}" />
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Padding="0,8">
       <Label Text="{Binding Text[DashboardSpecies]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="1" Text="{Binding Text[DashboardMethod]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="2" Text="{Binding Text[DashboardHeaviest]}" Style="{StaticResource SecondaryText}" FontSize="12" />
      </Grid>
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding LifetimeBests}" BindableLayout.ItemTemplate="{StaticResource BestRow}" />
      <VerticalStackLayout IsVisible="{Binding ShowLifetimeEmpty}" Padding="12,20" Spacing="10">
       <controls:IconView Source="icon_trophy.png" Tone="Muted" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
       <Label Text="{Binding LifetimeEmptyTitle}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
       <Label Text="{Binding Text[DashboardFirstBestHelp]}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
     </VerticalStackLayout>
    </Border>
   <Border Style="{StaticResource Card}" Padding="14" Shadow="{x:Null}" AutomationId="DashboardExplore">
    <VerticalStackLayout Spacing="12">
     <Label Text="{Binding Text[DashboardExplore]}" Style="{StaticResource Subheading}" />
     <Label Text="{Binding Text[DashboardDateRange]}" Style="{StaticResource SecondaryText}" />
     <Picker ItemsSource="{Binding DatePresets}" SelectedIndex="{Binding PresetIndex, Mode=OneWay}" SelectedIndexChanged="OnPresetChanged"
             Title="{Binding Text[DashboardDateRange]}" SemanticProperties.Description="{Binding Text[DashboardDateRange]}" AutomationId="DashboardPreset" />
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsCustom}">
      <VerticalStackLayout>
       <Label Text="{Binding Text[DashboardFrom]}" Style="{StaticResource SecondaryText}" />
       <DatePicker Date="{Binding FromDate, Mode=TwoWay}" SemanticProperties.Description="{Binding Text[DashboardFrom]}" AutomationId="DashboardFrom" />
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1">
       <Label Text="{Binding Text[DashboardTo]}" Style="{StaticResource SecondaryText}" />
       <DatePicker Date="{Binding ToDate, Mode=TwoWay}" SemanticProperties.Description="{Binding Text[DashboardTo]}" AutomationId="DashboardTo" />
      </VerticalStackLayout>
     </Grid>
     <Label Text="{Binding Text[DashboardSpecies]}" Style="{StaticResource SecondaryText}" />
     <Picker ItemsSource="{Binding SpeciesOptions}" ItemDisplayBinding="{Binding Label, x:DataType=models:DashboardChoiceModel}" SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
             Title="{Binding Text[DashboardSpecies]}" SemanticProperties.Description="{Binding Text[DashboardSpecies]}" AutomationId="DashboardSpeciesFilter" />
     <Label Text="{Binding Text[DashboardMethod]}" Style="{StaticResource SecondaryText}" />
     <Picker ItemsSource="{Binding MethodOptions}" ItemDisplayBinding="{Binding Label, x:DataType=models:DashboardChoiceModel}" SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
             Title="{Binding Text[DashboardMethod]}" SemanticProperties.Description="{Binding Text[DashboardMethod]}" AutomationId="DashboardMethodFilter" />
     <Label Text="{Binding Text[DashboardVenue]}" Style="{StaticResource SecondaryText}" />
     <Picker ItemsSource="{Binding VenueOptions}" ItemDisplayBinding="{Binding Label, x:DataType=models:DashboardChoiceModel}" SelectedItem="{Binding SelectedVenue, Mode=TwoWay}"
             Title="{Binding Text[DashboardVenue]}" SemanticProperties.Description="{Binding Text[DashboardVenue]}" AutomationId="DashboardVenueFilter" />
     <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Text="{Binding Text[DashboardApply]}" Style="{StaticResource PrimaryButton}" Clicked="OnApply" IsEnabled="{Binding CanApply}" AutomationId="DashboardApply" />
      <Button Grid.Column="1" Text="{Binding Text[DashboardReset]}" Style="{StaticResource SecondaryButton}" Clicked="OnReset" IsEnabled="{Binding CanApply}" AutomationId="DashboardReset" />
     </Grid>
     <BoxView HeightRequest="1" Opacity="0.15" Color="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Sky}}" />
     <Label Text="{Binding Text[DashboardStatistics]}" Style="{StaticResource Subheading}" AutomationId="DashboardStatistics" />
     <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Padding="0,8">
       <Label Text="{Binding Text[DashboardSpecies]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="1" Text="{Binding Text[DashboardMethod]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="2" Text="{Binding Text[DashboardCount]}" Style="{StaticResource SecondaryText}" FontSize="12" />
      </Grid>
     <VerticalStackLayout BindableLayout.ItemsSource="{Binding Statistics}" BindableLayout.ItemTemplate="{StaticResource CountRow}" />
     <Label Text="{Binding StatisticsEmptyText}" IsVisible="{Binding ShowStatisticsEmpty}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" Margin="0,16" />
     <BoxView HeightRequest="1" Opacity="0.15" Color="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Sky}}" />
     <Label Text="{Binding Text[DashboardFilteredBests]}" Style="{StaticResource Subheading}" AutomationId="DashboardFilteredBests" />
     <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Padding="0,8">
       <Label Text="{Binding Text[DashboardSpecies]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="1" Text="{Binding Text[DashboardMethod]}" Style="{StaticResource SecondaryText}" FontSize="12" />
       <Label Grid.Column="2" Text="{Binding Text[DashboardHeaviest]}" Style="{StaticResource SecondaryText}" FontSize="12" />
      </Grid>
     <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredBests}" BindableLayout.ItemTemplate="{StaticResource BestRow}" />
     <Label Text="{Binding FilteredEmptyText}" IsVisible="{Binding ShowFilteredEmpty}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" Margin="0,16" />
    </VerticalStackLayout>
   </Border>
   <Border Style="{StaticResource Card}" IsVisible="{Binding ShowImportSuggestion}" Padding="14" Shadow="{x:Null}" AutomationId="DashboardImportSuggestion">
    <VerticalStackLayout Spacing="8">
     <Label Text="{Binding Text[DashboardImportTitle]}" Style="{StaticResource Subheading}" />
     <Label Text="{Binding Text[DashboardImportHelp]}" Style="{StaticResource SecondaryText}" />
     <Button Text="{Binding Text[DashboardImport]}" Style="{StaticResource SecondaryButton}" Clicked="OnImport" AutomationId="DashboardImport" />
    </VerticalStackLayout>
   </Border>
   <Label Text="{Binding Text[DashboardOnlineOnly]}" Style="{StaticResource SecondaryText}" FontSize="12" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
