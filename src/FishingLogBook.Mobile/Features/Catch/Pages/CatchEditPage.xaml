<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Catch.ViewModels"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:photoViews="clr-namespace:FishingLogBook.Mobile.Features.Photographs.Views"
             x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchEditPage"
             x:DataType="vm:CatchEditViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
  <Grid RowDefinitions="56,*">
    <Grid ColumnDefinitions="48,*,48" Padding="4,0">
      <Grid SemanticProperties.Description="{Binding Text[Back]}" AutomationId="CatchEditBack">
        <controls:IconView Source="icon_chevron.png" Tone="Default" Rotation="180" WidthRequest="22" HeightRequest="22" />
        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBack" /></Grid.GestureRecognizers>
      </Grid>
      <Label Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource Heading}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
      <Button Grid.Column="2" Text="{Binding Text[Save]}" Style="{StaticResource PrimaryButton}" Clicked="OnSave" IsEnabled="{Binding CanSave}" AutomationId="CatchEditSave" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="16,4,16,32" Spacing="16" MaximumWidthRequest="720">
        <Label Text="{Binding Text[CatchNotSignedIn]}" IsVisible="{Binding NotSignedIn}" Style="{StaticResource SecondaryText}" />
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        <Label Text="{Binding Text[CatchDraftRestored]}" IsVisible="{Binding ShowDraftRestored}" Style="{StaticResource SecondaryText}" />
        <photoViews:PhotoCollectionEditorView ViewModel="{Binding Photographs}" MaximumCount="10" />
        <Label Text="{Binding PhotoConflictText}" IsVisible="{Binding ShowPhotoConflict}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Label Text="{Binding Text[CatchPhotoDateConflict]}" IsVisible="{Binding ShowDateConflict}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Label Text="{Binding ValidationText}" IsVisible="{Binding HasValidation}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Style="{StaticResource SecondaryText}" />
        <VerticalStackLayout Spacing="8" IsVisible="{Binding CanInteract}">
          <Label Text="{Binding Text[FishingMethod]}" Style="{StaticResource SectionTitle}" />
          <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding MethodOptions}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:CatchChipOptionModel">
                  <controls:ChipView Text="{Binding Name}" IsSelected="{Binding IsSelected}" Tapped="OnMethodChip" CommandParameter="{Binding Name}" />
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
          </ScrollView>
          <Label Text="{Binding Text[FilterSpecies]}" Style="{StaticResource SectionTitle}" />
          <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SpeciesOptions}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:CatchChipOptionModel">
                  <controls:ChipView Text="{Binding Name}" IsSelected="{Binding IsSelected}" Tapped="OnSpeciesChip" CommandParameter="{Binding Name}" />
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
          </ScrollView>
          <Label Text="{Binding Text[CaughtOnLabel]}" Style="{StaticResource SectionTitle}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <DatePicker Date="{Binding CaughtOnLocal}" Format="d" />
            <TimePicker Grid.Column="1" Time="{Binding CaughtOnTime}" />
          </Grid>
          <Button Text="{Binding WeightSummary}" Style="{StaticResource SecondaryButton}" Clicked="OnEditWeight" />
          <Button Text="{Binding LengthSummary}" Style="{StaticResource SecondaryButton}" Clicked="OnEditLength" />
          <Button Text="{Binding Text[CatchCaptureLocation]}" Style="{StaticResource SecondaryButton}" Clicked="OnCaptureLocation" />
          <Label Text="{Binding LocationCaption}" Style="{StaticResource SecondaryText}" />
          <Label Text="{Binding Text[CatchBaitOrLure]}" Style="{StaticResource SectionTitle}" />
          <Entry Text="{Binding BaitOrLure}" MaxLength="100" />
          <Label Text="{Binding Text[Notes]}" Style="{StaticResource SectionTitle}" />
          <Editor Text="{Binding Notes}" MaxLength="2000" AutoSize="TextChanges" MinimumHeightRequest="80" />
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
