<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Catch.ViewModels"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:editor="clr-namespace:FishingLogBook.Mobile.Features.Catch.Components.RecordCatchEditor"
             x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchEditPage"
             x:DataType="vm:CatchEditViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
  <Grid RowDefinitions="48,*,Auto">
    <Grid ColumnDefinitions="48,*,48" Padding="4,0">
      <Grid SemanticProperties.Description="{Binding Text[Back]}" AutomationId="CatchEditBack">
        <controls:IconView Source="icon_chevron.png" Tone="Default" Rotation="180" WidthRequest="20" HeightRequest="20" />
        <Grid.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnBack" />
        </Grid.GestureRecognizers>
      </Grid>
      <Label Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource Heading}" FontSize="17"
             HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="16,8,16,16" Spacing="{StaticResource SpaceMedium}" MaximumWidthRequest="720">
        <editor:RecordCatchEditorView BindingContext="{Binding}" />
      </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout Grid.Row="2" Padding="16,8,16,24" Spacing="8" BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
      <Label Text="{Binding ValidationText}" IsVisible="{Binding HasValidation}"
             TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
             AutomationId="RecordCatchValidation" />
      <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Style="{StaticResource SecondaryText}"
             AutomationId="RecordCatchStatus" />
      <Button Text="{Binding SaveButtonText}" Style="{StaticResource PrimaryButton}"
              IsEnabled="{Binding CanSave}" Clicked="OnSave" HorizontalOptions="Fill"
              MinimumHeightRequest="48" AutomationId="RecordCatchSave" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
