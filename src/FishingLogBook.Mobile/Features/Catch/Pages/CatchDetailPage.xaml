<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models" xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
 xmlns:photos="clr-namespace:FishingLogBook.Mobile.Features.Photographs.Views"
 x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchDetailPage" x:DataType="models:CatchPresentationModel"
 Title="{Binding Text[Detail]}" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
 <Grid RowDefinitions="56,*">
  <Grid ColumnDefinitions="48,*,48" Padding="4,0" BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
   <Grid SemanticProperties.Description="{Binding Text[Back]}" AutomationId="DetailBack">
    <controls:IconView Source="icon_chevron.png" Tone="Default" Rotation="180" WidthRequest="22" HeightRequest="22" />
    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBack" /></Grid.GestureRecognizers>
   </Grid>
   <Label Grid.Column="1" Text="{Binding Text[Detail]}" Style="{StaticResource Heading}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
   <Grid Grid.Column="2" SemanticProperties.Description="{Binding Text[MoreActions]}" AutomationId="MoreActions">
    <controls:IconView Source="icon_more.png" Tone="Default" WidthRequest="22" HeightRequest="22" />
    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnMore" /></Grid.GestureRecognizers>
   </Grid>
  </Grid>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="16,4,16,24" Spacing="16" MaximumWidthRequest="720">
   <photos:PhotoCarouselView IsVisible="{Binding HasPhoto}" PhotoPath="{Binding SelectedPhoto}" PositionText="{Binding PhotoPosition}"
                             Text="{Binding Text}" PhotoHint="{Binding Text[EditCatch]}" HasMultiplePhotographs="{Binding HasMultiplePhotos}"
                             PhotoTapped="OnEditCatch" PreviousRequested="OnPreviousPhoto" NextRequested="OnNextPhoto" />
   <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoPhoto}" Padding="16"><Label Text="{Binding Text[NoPhoto]}" Style="{StaticResource SecondaryText}" /></Border>
   <VerticalStackLayout Spacing="2">
    <Label Text="{Binding Species}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2" AutomationId="CatchSpecies" />
    <Label Text="{Binding CaughtOn}" Style="{StaticResource SecondaryText}" />
   </VerticalStackLayout>
   <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
    <controls:InfoTile Icon="icon_pin.png" Caption="{Binding Text[Location]}" Value="{Binding Place}" />
    <controls:InfoTile Grid.Column="1" Icon="icon_hook.png" Caption="{Binding Text[FishingMethod]}" Value="{Binding Method}" />
    <controls:InfoTile Grid.Row="1" Icon="icon_scale.png" Caption="{Binding Text[Weight]}" Value="{Binding Weight}" />
    <controls:InfoTile Grid.Row="1" Grid.Column="1" Icon="icon_ruler.png" Caption="{Binding Text[Length]}" Value="{Binding Length}" />
   </Grid>
   <Label Text="{Binding BaitOrLure}" Style="{StaticResource SecondaryText}" />
   <BoxView Style="{StaticResource Divider}" />
   <VerticalStackLayout Spacing="6" IsVisible="{Binding HasNotes}">
    <Label Text="{Binding Text[Notes]}" Style="{StaticResource SectionTitle}" />
    <Label Text="{Binding Notes}" />
   </VerticalStackLayout>
   <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPhoto}">
    <Label Text="{Binding Text[Photos]}" Style="{StaticResource SectionTitle}" />
    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"><HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Thumbnails}">
     <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:CatchPhotoThumbnailModel">
      <Border StrokeThickness="3" Stroke="Transparent" Padding="0" WidthRequest="72" HeightRequest="72"
              SemanticProperties.Description="{Binding Description}" AutomationId="PhotoThumbnail">
       <Border.Triggers>
        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
         <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryFillDark}}" />
        </DataTrigger>
       </Border.Triggers>
       <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnThumbnailTapped" /></Border.GestureRecognizers>
       <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
       <Image Source="{Binding Path}" Aspect="AspectFill" AutomationProperties.IsInAccessibleTree="False" />
      </Border>
     </DataTemplate></BindableLayout.ItemTemplate>
    </HorizontalStackLayout></ScrollView>
   </VerticalStackLayout>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
