<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models" x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchDetailPage"
 x:DataType="models:CatchPresentationModel" Title="{Binding Text[Detail]}">
 <ScrollView><VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLarge}" MaximumWidthRequest="720">
  <VerticalStackLayout Spacing="{StaticResource SpaceSmall}">
   <Label Text="{Binding Text[SampleBadge]}" Style="{StaticResource Eyebrow}" />
   <Label Text="{Binding Species}" Style="{StaticResource Heading}" AutomationId="CatchSpecies" />
   <Label Text="{Binding Place}" Style="{StaticResource SecondaryText}" />
  </VerticalStackLayout>
  <VerticalStackLayout Spacing="{StaticResource SpaceSmall}" IsVisible="{Binding HasPhoto}">
   <Border Style="{StaticResource Card}" Padding="0"><Image Source="{Binding PreviewAsset}" HeightRequest="220" Aspect="AspectFill" SemanticProperties.Description="{Binding Text[DemoImage]}" /></Border>
   <Label Text="{Binding Text[DemoImage]}" Style="{StaticResource SecondaryText}" />
   <Button Text="{Binding Text[Preview]}" Clicked="OnPreview" AutomationId="OpenPhoto" />
  </VerticalStackLayout>
  <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoPhoto}"><Label Text="{Binding Text[NoPhoto]}" Style="{StaticResource SecondaryText}" /></Border>
  <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="{StaticResource SpaceMedium}">
   <Label Text="{Binding Text[CatchFacts]}" Style="{StaticResource Subheading}" />
   <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
    <VerticalStackLayout Spacing="4" Padding="0,0,24,16" FlexLayout.Basis="50%">
     <Label Text="{Binding Text[Weight]}" Style="{StaticResource SecondaryText}" /><Label Text="{Binding Weight}" Style="{StaticResource Subheading}" />
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="4" Padding="0,0,0,16" FlexLayout.Basis="50%">
     <Label Text="{Binding Text[Length]}" Style="{StaticResource SecondaryText}" /><Label Text="{Binding Length}" Style="{StaticResource Subheading}" />
    </VerticalStackLayout>
   </FlexLayout>
   <Label Text="{Binding Text[CaughtOn]}" Style="{StaticResource SecondaryText}" /><Label Text="{Binding CaughtOn}" />
  </VerticalStackLayout></Border>
  <VerticalStackLayout Spacing="{StaticResource SpaceSmall}"><Label Text="{Binding Text[Notes]}" Style="{StaticResource Subheading}" /><Label Text="{Binding Notes}" /></VerticalStackLayout>
 </VerticalStackLayout></ScrollView>
</ContentPage>
