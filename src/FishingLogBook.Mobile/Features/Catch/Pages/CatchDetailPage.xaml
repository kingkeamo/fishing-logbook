<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models"
             x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchDetailPage"
             x:DataType="models:CatchPresentationModel" Title="{Binding Text[Detail]}">
  <ScrollView>
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLarge}">
      <Label Text="{Binding Text[DemoNotice]}" Style="{StaticResource SecondaryText}" />
      <Label Text="{Binding Species}" Style="{StaticResource Heading}" AutomationId="CatchSpecies" />
      <VerticalStackLayout Spacing="{StaticResource SpaceSmall}">
        <Label Text="{Binding Text[CaughtOn]}" Style="{StaticResource SecondaryText}" />
        <Label Text="{Binding CaughtOn}" />
      </VerticalStackLayout>
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceMedium}">
          <Label Text="{Binding Text[Weight]}" Style="{StaticResource Subheading}" />
          <Label Text="{Binding Weight}" />
          <Label Text="{Binding Text[Length]}" Style="{StaticResource Subheading}" />
          <Label Text="{Binding Length}" />
          <Label Text="{Binding Text[Location]}" Style="{StaticResource Subheading}" />
          <Label Text="{Binding Place}" />
        </VerticalStackLayout>
      </Border>
      <VerticalStackLayout Spacing="{StaticResource SpaceSmall}" IsVisible="{Binding HasPhoto}">
        <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
          <Image Source="{Binding PreviewAsset}" HeightRequest="200" Aspect="AspectFit" SemanticProperties.Description="{Binding Text[DemoImage]}" />
        </Border>
        <Label Text="{Binding Text[DemoImage]}" Style="{StaticResource SecondaryText}" />
        <Button Text="{Binding Text[Preview]}" Clicked="OnPreview" AutomationId="OpenPhoto" />
      </VerticalStackLayout>
      <Label Text="{Binding Text[NoPhoto]}" IsVisible="{Binding HasNoPhoto}" />
      <Label Text="{Binding Text[Notes]}" Style="{StaticResource Subheading}" />
      <Label Text="{Binding Notes}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
