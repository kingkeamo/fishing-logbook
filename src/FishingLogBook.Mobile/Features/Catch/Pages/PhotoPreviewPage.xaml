<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models"
             x:Class="FishingLogBook.Mobile.Features.Catch.Pages.PhotoPreviewPage"
             x:DataType="models:CatchPresentationModel" Title="{Binding Text[PhotoPreview]}">
  <ScrollView>
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLarge}">
      <Label Text="{Binding Text[DemoNotice]}" Style="{StaticResource SecondaryText}" />
      <Label Text="{Binding Species}" Style="{StaticResource Heading}" />
      <Border BackgroundColor="White" StrokeThickness="0" Padding="16" IsVisible="{Binding HasPhoto}">
        <Image Source="{Binding PreviewAsset}" HeightRequest="320" Aspect="AspectFit" SemanticProperties.Description="{Binding Text[DemoImage]}" AutomationId="PhotoPreview" />
      </Border>
      <Label Text="{Binding Text[DemoImage]}" IsVisible="{Binding HasPhoto}" />
      <Label Text="{Binding Text[NoPhoto]}" IsVisible="{Binding HasNoPhoto}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
