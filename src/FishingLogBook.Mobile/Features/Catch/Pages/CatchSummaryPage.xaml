<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models" xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Catch.ViewModels"
 xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls" x:Class="FishingLogBook.Mobile.Features.Catch.Pages.CatchSummaryPage"
 x:DataType="vm:CatchListViewModel" Title="{Binding Text[Catches]}">
 <Grid Padding="{StaticResource PagePadding}">
  <CollectionView ItemsSource="{Binding Catches}" SelectionMode="None" AutomationId="CatchList" MaximumWidthRequest="720" HorizontalOptions="Fill">
   <CollectionView.Header>
    <VerticalStackLayout Spacing="{StaticResource SpaceSmall}" Padding="0,8,0,24">
     <Label Text="{Binding Text[SampleBadge]}" Style="{StaticResource Eyebrow}" />
     <Label Text="{Binding Text[Journal]}" Style="{StaticResource Heading}" />
     <Label Text="{Binding Text[DemoShort]}" Style="{StaticResource SecondaryText}" />
    </VerticalStackLayout>
   </CollectionView.Header>
   <CollectionView.EmptyView><controls:ContentStateView BindingContext="{Binding State}" RetryRequested="OnRetry" /></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="models:CatchPresentationModel">
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20" Shadow="{StaticResource CardShadow}">
     <VerticalStackLayout Spacing="0">
      <Image Source="{Binding PreviewAsset}" IsVisible="{Binding HasPhoto}" HeightRequest="170" Aspect="AspectFill" SemanticProperties.Description="{Binding Text[DemoImage]}" />
      <VerticalStackLayout Padding="16" Spacing="{StaticResource SpaceSmall}">
       <Label Text="{Binding ShortDate}" Style="{StaticResource Eyebrow}" />
       <Label Text="{Binding Species}" Style="{StaticResource Subheading}" />
       <Label Text="{Binding Place}" Style="{StaticResource SecondaryText}" />
       <Label Text="{Binding Weight}" IsVisible="{Binding HasPhoto}" />
       <Label Text="{Binding Text[NoPhoto]}" IsVisible="{Binding HasNoPhoto}" Style="{StaticResource SecondaryText}" />
       <Button Text="{Binding Text[OpenCatch]}" SemanticProperties.Description="{Binding OpenDescription}" Clicked="OnOpenCatch" CommandParameter="{Binding .}" AutomationId="OpenCatch" />
      </VerticalStackLayout>
     </VerticalStackLayout>
    </Border>
   </DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
