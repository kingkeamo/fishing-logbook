<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Catch.ViewModels"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Catch.Models"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:photoViews="clr-namespace:FishingLogBook.Mobile.Features.Photographs.Views"
             xmlns:shared="clr-namespace:FishingLogBook.Shared.Constants;assembly=FishingLogBook.Shared"
             x:Class="FishingLogBook.Mobile.Features.Catch.Components.RecordCatchEditor.RecordCatchEditorView"
             x:DataType="vm:CatchEditViewModel">
  <VerticalStackLayout Spacing="{StaticResource SpaceMedium}">
    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />
    <Label Text="{Binding Text[CatchNotSignedIn]}" IsVisible="{Binding NotSignedIn}" Style="{StaticResource SecondaryText}" />
    <Label Text="{Binding Text[CatchDraftRestored]}" IsVisible="{Binding ShowDraftRestored}" Style="{StaticResource SecondaryText}" />
    <Label Text="{Binding Text[CatchCatalogueUnavailable]}" IsVisible="{Binding IsCatalogueUnavailable}" Style="{StaticResource SecondaryText}"
           AutomationId="RecordCatchCatalogueUnavailable" />

    <VerticalStackLayout Spacing="{StaticResource SpaceSmall}" IsVisible="{Binding CanInteract}">
      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Text[FishingMethod]}" Style="{StaticResource TileCaption}" />
        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding MethodChipRow}"
                    AutomationId="RecordCatchMethodChips">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:CatchChipOptionModel">
              <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                 CommandParameter="{Binding}" Tapped="OnMethodChip" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Text[FilterSpecies]}" Style="{StaticResource TileCaption}" />
        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding SpeciesChipRow}"
                    AutomationId="RecordCatchSpeciesChips">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:CatchChipOptionModel">
              <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                 CommandParameter="{Binding}" Tapped="OnSpeciesChip" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
      </VerticalStackLayout>

      <photoViews:PhotoCollectionEditorView ViewModel="{Binding Photographs}" MaximumCount="10" ShowUseDetails="True" Margin="0,4,0,4" />
      <Label Text="{Binding PhotoConflictText}" IsVisible="{Binding ShowPhotoConflict}"
             TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
      <Label Text="{Binding Text[CatchPhotoDateConflict]}" IsVisible="{Binding ShowDateConflict}"
             TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />

      <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowCaughtOn}">
        <Label Text="{Binding Text[CaughtOnLabel]}" Style="{StaticResource TileCaption}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <DatePicker Date="{Binding CaughtOnLocal}" Format="d" AutomationId="RecordCatchCaughtOnDate" />
          <TimePicker Grid.Column="1" Time="{Binding CaughtOnTime}" AutomationId="RecordCatchCaughtOnTime" />
        </Grid>
      </VerticalStackLayout>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,4">
        <Border Style="{StaticResource Card}" Padding="12,10" Shadow="{x:Null}" AutomationId="RecordCatchWeight">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnEditWeight" />
          </Border.GestureRecognizers>
          <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Text[MeasureWeight]}" Style="{StaticResource TileCaption}" />
            <Label Text="{Binding WeightSummary}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10" Shadow="{x:Null}" AutomationId="RecordCatchLength">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnEditLength" />
          </Border.GestureRecognizers>
          <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Text[MeasureLength]}" Style="{StaticResource TileCaption}" />
            <Label Text="{Binding LengthSummary}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
          </VerticalStackLayout>
        </Border>
      </Grid>

      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Text[CatchBaitOrLure]}" Style="{StaticResource TileCaption}" />
        <Border Style="{StaticResource InputField}">
          <Entry Text="{Binding BaitOrLure}" Style="{StaticResource FieldEntry}"
                 MaxLength="{x:Static shared:CatchDetailConstants.MaxBaitOrLureLength}"
                 SemanticProperties.Description="{Binding Text[CatchBaitOrLure]}"
                 AutomationId="RecordCatchBaitOrLure" />
        </Border>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Text[Notes]}" Style="{StaticResource TileCaption}" />
        <Border Style="{StaticResource InputField}">
          <Editor Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="96"
                  MaxLength="{x:Static shared:CatchDetailConstants.MaxNotesLength}"
                  BackgroundColor="Transparent"
                  TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Paper}}"
                  SemanticProperties.Description="{Binding Text[Notes]}"
                  AutomationId="RecordCatchNotes" />
        </Border>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="4" Margin="0,4,0,4">
        <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" MinimumHeightRequest="48">
          <controls:IconView Source="icon_pin.png" Tone="Muted" WidthRequest="22" HeightRequest="22"
                             VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
          <Label Grid.Column="1" Text="{Binding LocationCaption}" Style="{StaticResource SecondaryText}" FontSize="13"
                 VerticalOptions="Center" LineBreakMode="WordWrap" AutomationId="RecordCatchLocationCaption" />
          <Button Grid.Column="2" Text="{Binding LocationActionText}" Style="{StaticResource SecondaryButton}" HorizontalOptions="End"
                  VerticalOptions="Center" MaximumWidthRequest="176" MinimumHeightRequest="48" Padding="12,8"
                  IsVisible="{Binding ShowLocationAction}" IsEnabled="{Binding CanCaptureLocation}" Clicked="OnCaptureLocation"
                  AutomationId="RecordCatchLocationAction" />
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsCapturingLocation}" IsVisible="{Binding IsCapturingLocation}"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Label Text="{Binding LocationStatusText}" IsVisible="{Binding HasLocationStatus}" Style="{StaticResource SecondaryText}"
               SemanticProperties.Description="{Binding LocationStatusText}" AutomationId="RecordCatchLocationStatus">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding HasLocationError}" Value="True">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </VerticalStackLayout>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="48" Margin="0,4,0,4" IsVisible="{Binding Trip.ShowAssociation}"
            AutomationId="RecordCatchTripAssociation">
        <VerticalStackLayout VerticalOptions="Center">
          <Label Text="{Binding Text[CatchTripRecordingIn]}" Style="{StaticResource TileCaption}" />
          <Label Text="{Binding Trip.TripName}" Style="{StaticResource SecondaryText}" LineBreakMode="WordWrap"
                 AutomationId="RecordCatchTripName" />
        </VerticalStackLayout>
        <Button Grid.Column="1" Text="{Binding Text[CatchTripLeave]}" Style="{StaticResource SecondaryButton}"
                MinimumHeightRequest="48" Padding="12,8" MaximumWidthRequest="176"
                IsVisible="{Binding Trip.CanLeave}" Clicked="OnLeaveTrip" AutomationId="RecordCatchTripLeave" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="48" IsVisible="{Binding Trip.ShowStandalone}"
            AutomationId="RecordCatchTripStandalone">
        <Label Text="{Binding Text[CatchTripNotPartOfTrip]}" Style="{StaticResource SecondaryText}" VerticalOptions="Center" />
        <Button Grid.Column="1" Text="{Binding Text[CatchTripRejoin]}" Style="{StaticResource SecondaryButton}"
                MinimumHeightRequest="48" Padding="12,8" MaximumWidthRequest="176"
                IsVisible="{Binding Trip.CanRejoin}" Clicked="OnRejoinTrip" AutomationId="RecordCatchTripRejoin" />
      </Grid>

      <VerticalStackLayout Spacing="4" Margin="0,4,0,0" IsVisible="{Binding ShowAnglerSection}">
        <Label Text="{Binding Text[CatchAnglerLabel]}" Style="{StaticResource TileCaption}" />
        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding AnglerOptions}"
                    AutomationId="RecordCatchAnglerChips">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:CatchChipOptionModel">
              <controls:ChipView Margin="0,0,8,8" Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                 CommandParameter="{Binding Code}" Tapped="OnAnglerChip" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
      </VerticalStackLayout>

    </VerticalStackLayout>
  </VerticalStackLayout>
</ContentView>
