<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:services="clr-namespace:FishingLogBook.Mobile.Features.Settings.Services"
 x:Class="FishingLogBook.Mobile.Features.Settings.Pages.SettingsPage" x:DataType="services:PreferenceService" Title="{Binding Text[Settings]}">
 <ScrollView><VerticalStackLayout Padding="16,12,16,20" Spacing="10" MaximumWidthRequest="720">
  <Label Text="{Binding Text[SettingsIntro]}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level1" />
  <Label Text="{Binding Text[SettingsBody]}" Style="{StaticResource SecondaryText}" Margin="0,-8,0,0" />
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[Theme]}" Style="{StaticResource SectionTitle}" />
   <RadioButton Style="{StaticResource SettingsRadioButton}" x:Name="ThemeSystem" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeSystem" Content="{Binding Text[ThemeSystem]}" />
   <RadioButton Style="{StaticResource SettingsRadioButton}" x:Name="ThemeLight" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeLight" Content="{Binding Text[ThemeLight]}" />
   <RadioButton Style="{StaticResource SettingsRadioButton}" x:Name="ThemeDark" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeDark" Content="{Binding Text[ThemeDark]}" />
  </VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}" Padding="16,12"><VerticalStackLayout Spacing="8">
   <Label Text="{Binding Text[Account]}" Style="{StaticResource SectionTitle}" />
   <Label x:Name="AccountEmail" Style="{StaticResource SecondaryText}" AutomationId="AccountEmail" />
   <Button Text="{Binding Text[SignOut]}" HeightRequest="48" Style="{StaticResource SecondaryButton}"
    Clicked="OnSignOut" AutomationId="SignOut"
    SemanticProperties.Description="{Binding Text[SignOutDescription]}" />
  </VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[Language]}" Style="{StaticResource SectionTitle}" />
   <RadioButton Style="{StaticResource SettingsRadioButton}" x:Name="LanguageEnglish" GroupName="Language" CheckedChanged="OnLanguageChanged" AutomationId="LanguageEnglish" Content="{Binding Text[LanguageEnglish]}" />
   <RadioButton Style="{StaticResource SettingsRadioButton}" x:Name="LanguageFrench" GroupName="Language" CheckedChanged="OnLanguageChanged" AutomationId="LanguageFrench" Content="{Binding Text[LanguageFrench]}" />
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
