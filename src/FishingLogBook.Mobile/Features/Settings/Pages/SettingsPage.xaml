<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:services="clr-namespace:FishingLogBook.Mobile.Features.Settings.Services" xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
 x:Class="FishingLogBook.Mobile.Features.Settings.Pages.SettingsPage" x:DataType="services:PreferenceService" Title="{Binding Text[Settings]}">
 <ScrollView><VerticalStackLayout Padding="16,12,16,20" Spacing="10" MaximumWidthRequest="720">
  <Label Text="{Binding Text[SettingsIntro]}" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level1" />
  <Label Text="{Binding Text[SettingsBody]}" Style="{StaticResource SecondaryText}" Margin="0,-8,0,0" />
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[Theme]}" Style="{StaticResource SectionTitle}" />
   <RadioButton x:Name="ThemeSystem" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeSystem" Content="{Binding Text[ThemeSystem]}" />
   <RadioButton x:Name="ThemeLight" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeLight" Content="{Binding Text[ThemeLight]}" />
   <RadioButton x:Name="ThemeDark" GroupName="Theme" CheckedChanged="OnAppearanceChanged" AutomationId="ThemeDark" Content="{Binding Text[ThemeDark]}" />
  </VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[Language]}" Style="{StaticResource SectionTitle}" />
   <RadioButton x:Name="LanguageEnglish" GroupName="Language" CheckedChanged="OnLanguageChanged" AutomationId="LanguageEnglish" Content="{Binding Text[LanguageEnglish]}" />
   <RadioButton x:Name="LanguageFrench" GroupName="Language" CheckedChanged="OnLanguageChanged" AutomationId="LanguageFrench" Content="{Binding Text[LanguageFrench]}" />
  </VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[Units]}" Style="{StaticResource SectionTitle}" />
   <Label Text="{Binding Text[MeasureWeight]}" Style="{StaticResource SecondaryText}" />
   <HorizontalStackLayout Spacing="16">
    <RadioButton x:Name="WeightKg" GroupName="WeightUnit" CheckedChanged="OnWeightUnitChanged" AutomationId="WeightUnitKg" Content="{Binding Text[MeasureUnitKg]}" />
    <RadioButton x:Name="WeightLb" GroupName="WeightUnit" CheckedChanged="OnWeightUnitChanged" AutomationId="WeightUnitLb" Content="{Binding Text[MeasureUnitLb]}" />
   </HorizontalStackLayout>
   <Label Text="{Binding Text[MeasureLength]}" Style="{StaticResource SecondaryText}" />
   <HorizontalStackLayout Spacing="16">
    <RadioButton x:Name="LengthCm" GroupName="LengthUnit" CheckedChanged="OnLengthUnitChanged" AutomationId="LengthUnitCm" Content="{Binding Text[MeasureUnitCm]}" />
    <RadioButton x:Name="LengthIn" GroupName="LengthUnit" CheckedChanged="OnLengthUnitChanged" AutomationId="LengthUnitIn" Content="{Binding Text[MeasureUnitIn]}" />
   </HorizontalStackLayout>
  </VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}" Padding="16,4"><VerticalStackLayout Spacing="0">
   <Label Text="{Binding Text[DataSection]}" Style="{StaticResource SectionTitle}" />
   <Grid ColumnDefinitions="*,24" HeightRequest="48" SemanticProperties.Description="{Binding Text[ClearLocalData]}" AutomationId="ClearLocalData">
    <Label Text="{Binding Text[ClearLocalData]}" Style="{StaticResource ActionText}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" VerticalOptions="Center" />
    <controls:IconView Grid.Column="1" Source="icon_chevron.png" Tone="Danger" WidthRequest="18" HeightRequest="18" />
    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnClearLocalData" /></Grid.GestureRecognizers>
   </Grid>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
