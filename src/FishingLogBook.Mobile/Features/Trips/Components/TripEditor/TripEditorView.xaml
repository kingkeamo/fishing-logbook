<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Trips.Models"
 xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Trips.ViewModels"
 xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
 xmlns:locationPicker="clr-namespace:FishingLogBook.Mobile.Features.Trips.Components.TripLocationPicker"
 xmlns:photographs="clr-namespace:FishingLogBook.Mobile.Features.Trips.Components.TripPhotographs"
 xmlns:notes="clr-namespace:FishingLogBook.Mobile.Features.Trips.Components.TripNotes"
 xmlns:catches="clr-namespace:FishingLogBook.Mobile.Features.Trips.Components.TripCatches"
 x:Class="FishingLogBook.Mobile.Features.Trips.Components.TripEditor.TripEditorView" x:DataType="vm:TripEditViewModel">
 <Border Style="{StaticResource Card}" Padding="12" Shadow="{x:Null}" AutomationId="TripEditor">
  <VerticalStackLayout Spacing="12">
   <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
    <VerticalStackLayout Spacing="2">
     <Label Text="{Binding Text[TripEditTitle]}" Style="{StaticResource Heading}" FontSize="20" SemanticProperties.HeadingLevel="Level1" AutomationId="TripEditorHeading" />
     <Label Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" FontSize="13" AutomationId="TripEditorSummary" />
    </VerticalStackLayout>
    <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" VerticalOptions="Start" SemanticProperties.Description="{Binding Text[TripParticipants]}" AutomationId="TripEditorParticipants">
     <controls:IconView Source="icon_people.png" Tone="Default" WidthRequest="24" HeightRequest="24" />
     <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnParticipants" /></Grid.GestureRecognizers>
    </Grid>
   </Grid>
   <VerticalStackLayout Spacing="4">
    <Label Text="{Binding Text[TripEditTripTitle]}" Style="{StaticResource TileCaption}" />
    <Border Style="{StaticResource InputField}">
     <Entry Text="{Binding EditTitle, Mode=TwoWay}" MaxLength="120" Style="{StaticResource FieldEntry}" SemanticProperties.Description="{Binding Text[TripEditTripTitle]}" AutomationId="TripEditTitleEntry" />
    </Border>
   </VerticalStackLayout>
   <locationPicker:TripLocationPickerView x:Name="Location" Options="{Binding LocationOptions}" PlaceName="{Binding EditPlace, Mode=TwoWay}"
     Heading="{Binding Text[TripFishingLocation]}" OtherText="{Binding Text[TripOtherLocation]}" ClearText="{Binding Text[TripClearLocation]}" />
   <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
   <photographs:TripPhotographsView x:Name="Photos" Photographs="{Binding Photographs}" Heading="{Binding Text[TripPhotographsLabel]}" EmptyText="{Binding Text[TripPhotographsEmpty]}"
     TakeText="{Binding Text[PhotoTakePicture]}" ChooseText="{Binding Text[PhotoChooseGallery]}" Message="{Binding MessageText}" />
   <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
   <notes:TripNotesView x:Name="Notes" Trip="{Binding Trip}" Notes="{Binding Notes}" Heading="{Binding Text[TripNotesLabel]}" EmptyText="{Binding Text[TripNotesEmpty]}" AddText="{Binding Text[TripNoteAdd]}"
     EditLabel="{Binding Text[TripNoteEdit]}" DeleteLabel="{Binding Text[TripNoteRemove]}" CanAdd="{Binding CanAddNotes}" />
   <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
   <VerticalStackLayout Spacing="8" AutomationId="TripEditorCatches">
    <Label Text="{Binding Text[TripCatchesLabel]}" Style="{StaticResource TileCaption}" />
    <Label Text="{Binding Text[TripEditCatchesNone]}" IsVisible="{Binding NoCatches}" Style="{StaticResource SecondaryText}" FontSize="13" AutomationId="TripEditCatchesEmpty" />
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Catches}" Spacing="6">
     <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:TripEditCatchModel">
      <Grid ColumnDefinitions="*,48" ColumnSpacing="8" MinimumHeightRequest="48" AutomationId="TripEditCatch">
       <VerticalStackLayout VerticalOptions="Center">
        <Label Text="{Binding Label}" Style="{StaticResource Subheading}" FontSize="15" />
        <Label Text="{Binding Measurements}" IsVisible="{Binding HasMeasurements}" Style="{StaticResource SecondaryText}" FontSize="12" />
       </VerticalStackLayout>
       <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" SemanticProperties.Description="{Binding RemoveLabel}" AutomationId="TripEditCatchRemove">
        <controls:IconView Source="icon_unlink.png" Tone="Default" WidthRequest="22" HeightRequest="22" />
        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRemoveCatch" /></Grid.GestureRecognizers>
       </Grid>
      </Grid>
     </DataTemplate></BindableLayout.ItemTemplate>
    </VerticalStackLayout>
    <catches:TripCatchesView x:Name="CatchActions" Trip="{Binding Trip}" RecordText="{Binding Text[TripRecordCatch]}" AddText="{Binding Text[TripAddExistingCatch]}" />
   </VerticalStackLayout>
   <Label Text="{Binding MessageText}" IsVisible="{Binding HasMessage}"
          TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" AutomationId="TripEditMessage" />
   <Label Text="{Binding Text[TripEditSaveScope]}" Style="{StaticResource SecondaryText}" FontSize="12" AutomationId="TripEditSaveScope" />
   <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
    <Button Text="{Binding Text[Cancel]}" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" MinimumHeightRequest="48" AutomationId="TripEditCancel" />
    <Button Grid.Column="1" Text="{Binding Text[TripEditSave]}" IsEnabled="{Binding CanInteract}" Clicked="OnSave" MinimumHeightRequest="48" AutomationId="TripEditSave" />
   </Grid>
  </VerticalStackLayout>
 </Border>
</ContentView>
