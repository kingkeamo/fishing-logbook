<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Trips.Models"
               xmlns:shared="clr-namespace:FishingLogBook.Shared.Dtos;assembly=FishingLogBook.Shared"
               xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Trips.ViewModels"
               x:Class="FishingLogBook.Mobile.Features.Trips.Modals.TripParticipantsModal"
               x:TypeArguments="x:Boolean" x:DataType="vm:TripParticipantsViewModel"
               Padding="0" Margin="0" VerticalOptions="End" HorizontalOptions="Fill" BackgroundColor="Transparent">
  <Border StrokeThickness="0" Padding="20,8,20,20"
          BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
    <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0" /></Border.StrokeShape>
    <VerticalStackLayout Spacing="12" SafeAreaEdges="Container">
      <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
               Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
      <Label Text="{Binding Text[TripParticipants]}" Style="{StaticResource Heading}" FontSize="20" Margin="0,8,0,0"
             SemanticProperties.HeadingLevel="Level1" AutomationId="TripParticipantsHeading" />
      <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />
      <ScrollView MaximumHeightRequest="480">
        <VerticalStackLayout Spacing="8">
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}" Spacing="6">
            <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:TripParticipantItemModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="48" AutomationId="TripParticipant">
                <VerticalStackLayout VerticalOptions="Center">
                  <Label Text="{Binding Name}" Style="{StaticResource Subheading}" FontSize="15" />
                  <Label Text="{Binding Status}" Style="{StaticResource SecondaryText}" FontSize="12" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="×" IsVisible="{Binding CanRemove}" CommandParameter="{Binding UserId}" Clicked="OnRemove"
                        Style="{StaticResource SecondaryButton}" WidthRequest="48" MinimumHeightRequest="48" Padding="0"
                        SemanticProperties.Description="{Binding Source={RelativeSource AncestorType={x:Type vm:TripParticipantsViewModel}}, Path=Text[TripRemoveParticipant]}"
                        AutomationId="TripParticipantRemove" />
              </Grid>
            </DataTemplate></BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Label Text="{Binding Text[TripParticipantsOwnerOnly]}" IsVisible="{Binding ShowOwnerOnlyNote}" Style="{StaticResource SecondaryText}" FontSize="13" />
          <VerticalStackLayout Spacing="8" IsVisible="{Binding CanInvite}">
            <Label Text="{Binding Text[TripInviteAngler]}" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding Text[TripInviteSearchHelp]}" Style="{StaticResource SecondaryText}" FontSize="13" />
            <Border Style="{StaticResource InputField}">
              <Entry Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{Binding Text[TripInviteSearchLabel]}" Style="{StaticResource FieldEntry}"
                     SemanticProperties.Description="{Binding Text[TripInviteSearchLabel]}" AutomationId="TripInviteSearch" />
            </Border>
            <Button Text="{Binding Text[Search]}" IsEnabled="{Binding CanSearch}" Style="{StaticResource SecondaryButton}" Clicked="OnSearch" MinimumHeightRequest="48" AutomationId="TripInviteSearchButton" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SearchResults}" Spacing="6">
              <BindableLayout.ItemTemplate><DataTemplate x:DataType="shared:AnglerSummaryDto">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="48" AutomationId="TripInviteResult">
                  <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}" Style="{StaticResource Subheading}" FontSize="15" />
                    <Label Text="{Binding HomeRegion}" Style="{StaticResource SecondaryText}" FontSize="12" />
                  </VerticalStackLayout>
                  <Button Grid.Column="1" Text="{Binding Source={RelativeSource AncestorType={x:Type vm:TripParticipantsViewModel}}, Path=Text[TripInvite]}"
                          CommandParameter="{Binding UserId}" Clicked="OnInvite" MinimumHeightRequest="48" AutomationId="TripInviteButton" />
                </Grid>
              </DataTemplate></BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </VerticalStackLayout>
          <Label Text="{Binding MessageText}" IsVisible="{Binding HasMessage}" Style="{StaticResource SecondaryText}" AutomationId="TripParticipantMessage" />
        </VerticalStackLayout>
      </ScrollView>
      <Button Text="{Binding Text[Done]}" Style="{StaticResource PrimaryButton}" Clicked="OnDone" AutomationId="TripParticipantsDone" />
    </VerticalStackLayout>
  </Border>
</toolkit:Popup>
