<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
 xmlns:participants="clr-namespace:FishingLogBook.Mobile.Features.Trips.Components.TripParticipants"
 xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Trips.ViewModels"
 x:Class="FishingLogBook.Mobile.Features.Trips.Modals.TripParticipantsModal"
 x:TypeArguments="x:Boolean" x:DataType="vm:TripParticipantsViewModel"
 Padding="0" Margin="20" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent">
 <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource Navy}}">
  <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
  <VerticalStackLayout Spacing="12" SafeAreaEdges="Container">
   <ScrollView MaximumHeightRequest="480">
    <participants:TripParticipantsView />
   </ScrollView>
   <Button Text="{Binding Text[Done]}" Style="{StaticResource PrimaryButton}" Clicked="OnDone" AutomationId="TripParticipantsDone" />
  </VerticalStackLayout>
 </Border>
</toolkit:Popup>