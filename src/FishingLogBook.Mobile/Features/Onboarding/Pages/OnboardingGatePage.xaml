<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Onboarding.ViewModels"
             x:Class="FishingLogBook.Mobile.Features.Onboarding.Pages.OnboardingGatePage"
             x:DataType="vm:OnboardingGateViewModel"
             Shell.NavBarIsVisible="False">
  <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center" MaximumWidthRequest="420"
                       HorizontalOptions="Center">
    <Image Source="{AppThemeBinding Light=brand_horizontal.png, Dark=brand_horizontal_dark.png}" HeightRequest="96" Aspect="AspectFit"
           SemanticProperties.Description="{Binding Text[Brand]}" />
    <controls:FishingLoaderView IsLoading="{Binding IsBusy}" HorizontalOptions="Center"
                                SemanticProperties.Description="{Binding Text[LoadingTitle]}" AutomationId="OnboardingGateLoading" />
    <Label Text="{Binding Text[LoadingTitle]}" IsVisible="{Binding IsBusy}" Style="{StaticResource Subheading}"
           HorizontalTextAlignment="Center" />
    <Border IsVisible="{Binding HasError}" Style="{StaticResource Card}" Padding="16" AutomationId="OnboardingGateError">
      <VerticalStackLayout Spacing="12">
        <Label Text="{Binding Text[ErrorTitle]}" Style="{StaticResource Subheading}" />
        <Label Text="{Binding Message}" Style="{StaticResource SecondaryText}" />
        <Button Text="{Binding Text[Retry]}" IsEnabled="{Binding CanRetry}" Clicked="OnRetry"
                Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" AutomationId="OnboardingGateRetry" />
      </VerticalStackLayout>
    </Border>
  </VerticalStackLayout>
</ContentPage>
