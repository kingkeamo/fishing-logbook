<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Presentation"
             x:Class="FishingLogBook.Mobile.Native.Controls.ContentStateView"
             x:DataType="models:ContentStateModel" IsVisible="{Binding IsVisible}">
  <VerticalStackLayout Spacing="12" Padding="24,32" HorizontalOptions="Center" MaximumWidthRequest="360">
    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <Image Source="empty_catches.png" HeightRequest="140" IsVisible="{Binding IsEmpty}" AutomationProperties.IsInAccessibleTree="False" />
    <Label Text="{Binding Title}" Style="{StaticResource Subheading}" HorizontalTextAlignment="Center" />
    <Label Text="{Binding Message}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
    <Button Text="{Binding Action}" IsVisible="{Binding IsEmpty}" Clicked="OnAction" AutomationId="StateAction" />
    <Button Text="{Binding Retry}" IsVisible="{Binding CanRetry}" Clicked="OnRetry" Style="{StaticResource SecondaryButton}" AutomationId="StateRetry" />
  </VerticalStackLayout>
</ContentView>
