<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             xmlns:models="clr-namespace:FishingLogBook.Mobile.Features.Profile.Models"
             xmlns:selectors="clr-namespace:FishingLogBook.Mobile.Features.Profile.Selectors"
             xmlns:vm="clr-namespace:FishingLogBook.Mobile.Features.Profile.ViewModels"
             x:Class="FishingLogBook.Mobile.Native.Controls.FishingPreferenceEditorView"
             x:Name="Root"
             x:DataType="vm:ProfileViewModel">
  <ContentView.Resources>
    <DataTemplate x:Key="MoreChipTemplate" x:DataType="models:PreferenceMoreActionModel">
      <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[More]}"
              Clicked="OnMore" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
              MinimumHeightRequest="48" Padding="18,10" CornerRadius="24" AutomationId="ProfileMore" />
    </DataTemplate>
    <selectors:PreferenceChipTemplateSelector x:Key="MethodChipSelector" MoreTemplate="{StaticResource MoreChipTemplate}">
      <selectors:PreferenceChipTemplateSelector.ItemTemplate>
        <DataTemplate x:DataType="models:MethodPreferenceEditModel">
          <controls:SelectionPillView Margin="0,0,8,8"
                                      Label="{Binding Name}"
                                      IsSelected="{Binding IsSelected}"
                                      IsEnabled="{Binding IsEnabled}"
                                      SelectionRequested="OnMethodSelection" />
        </DataTemplate>
      </selectors:PreferenceChipTemplateSelector.ItemTemplate>
    </selectors:PreferenceChipTemplateSelector>
    <selectors:PreferenceChipTemplateSelector x:Key="SpeciesChipSelector" MoreTemplate="{StaticResource MoreChipTemplate}">
      <selectors:PreferenceChipTemplateSelector.ItemTemplate>
        <DataTemplate x:DataType="models:SpeciesPreferenceEditModel">
          <controls:SelectionPillView Margin="0,0,8,8"
                                      Label="{Binding Name}"
                                      IsSelected="True"
                                      IsDefault="{Binding IsDefault}"
                                      ShowDefaultIndicator="True"
                                      DefaultText="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileDefault]}"
                                      ShowRemoveAction="True"
                                      IsEnabled="{Binding IsEnabled}"
                                      DefaultDescription="{Binding DefaultDescription}"
                                      RemoveDescription="{Binding RemoveDescription}"
                                      DefaultRequested="OnSpeciesDefault"
                                      RemoveRequested="OnSpeciesRemove" />
        </DataTemplate>
      </selectors:PreferenceChipTemplateSelector.ItemTemplate>
    </selectors:PreferenceChipTemplateSelector>
  </ContentView.Resources>
  <VerticalStackLayout Spacing="12">
    <Label Text="{Binding Text[ProfileMethods]}" Style="{StaticResource SectionTitle}" />
    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                BindableLayout.ItemsSource="{Binding MethodChipItems}"
                BindableLayout.ItemTemplateSelector="{StaticResource MethodChipSelector}"
                AutomationId="ProfileMethods" />

    <Label Text="{Binding Text[ProfileSetDefaultMethod]}" Style="{StaticResource SecondaryText}" />
    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                BindableLayout.ItemsSource="{Binding SelectedMethods}" AutomationId="ProfileDefaultMethods">
      <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="models:MethodPreferenceEditModel">
          <controls:SelectionPillView Margin="0,0,8,8"
                                      Label="{Binding Name}"
                                      IsSelected="True"
                                      IsDefault="{Binding IsDefault}"
                                      ShowDefaultIndicator="True"
                                      DefaultText="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileDefault]}"
                                      IsEnabled="{Binding IsEnabled}"
                                      DefaultDescription="{Binding DefaultDescription}"
                                      DefaultRequested="OnMethodDefault" />
        </DataTemplate>
      </BindableLayout.ItemTemplate>
    </FlexLayout>

    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedMethods}" Spacing="12">
      <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="models:MethodPreferenceEditModel">
          <VerticalStackLayout Spacing="6">
            <BoxView Style="{StaticResource Divider}" Margin="0,0,0,6" />
            <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=Text[ProfileSetDefaultSpecies]}" Style="{StaticResource SecondaryText}" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding SpeciesChipItems}"
                        BindableLayout.ItemTemplateSelector="{StaticResource SpeciesChipSelector}" />
          </VerticalStackLayout>
        </DataTemplate>
      </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48"
          IsVisible="{Binding ShowPrivacySwitches, Source={x:Reference Root}}">
      <Label Text="{Binding Text[ProfileShowMethods]}" VerticalOptions="Center" />
      <Switch Grid.Column="1" IsToggled="{Binding ShowPreferredFishingMethods}" AutomationId="ProfileShowMethods" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48"
          IsVisible="{Binding ShowPrivacySwitches, Source={x:Reference Root}}">
      <Label Text="{Binding Text[ProfileShowSpecies]}" VerticalOptions="Center" />
      <Switch Grid.Column="1" IsToggled="{Binding ShowPreferredSpecies}" AutomationId="ProfileShowSpecies" />
    </Grid>
    <VerticalStackLayout Spacing="4">
      <Label Text="{Binding Text[ProfileWeightUnit]}" Style="{StaticResource Eyebrow}" />
      <Border Style="{StaticResource InputField}">
        <Picker ItemsSource="{Binding WeightUnitOptions}"
                ItemDisplayBinding="{Binding Label, x:DataType={x:Null}}"
                SelectedItem="{Binding SelectedWeightUnit}" AutomationId="ProfileWeightUnit" />
      </Border>
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="4">
      <Label Text="{Binding Text[ProfileLengthUnit]}" Style="{StaticResource Eyebrow}" />
      <Border Style="{StaticResource InputField}">
        <Picker ItemsSource="{Binding LengthUnitOptions}"
                ItemDisplayBinding="{Binding Label, x:DataType={x:Null}}"
                SelectedItem="{Binding SelectedLengthUnit}" AutomationId="ProfileLengthUnit" />
      </Border>
    </VerticalStackLayout>
  </VerticalStackLayout>
</ContentView>
