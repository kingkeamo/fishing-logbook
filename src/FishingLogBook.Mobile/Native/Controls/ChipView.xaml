<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FishingLogBook.Mobile.Native.Controls.ChipView"
             x:Name="Root">
  <Grid HeightRequest="48" VerticalOptions="Center" SemanticProperties.Description="{Binding Text, Source={x:Reference Root}}">
    <Border x:Name="Surface" HeightRequest="36" VerticalOptions="Center" Padding="16,0" StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource DarkSurface}}">
      <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
      <Border.Triggers>
        <DataTrigger TargetType="Border" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
          <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryFillDark}}" />
          <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryFillDark}}" />
        </DataTrigger>
      </Border.Triggers>
      <Label x:Name="Caption" Text="{Binding Text, Source={x:Reference Root}}" FontSize="14" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap">
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
            <Setter Property="TextColor" Value="{StaticResource Paper}" />
            <Setter Property="FontAttributes" Value="Bold" />
          </DataTrigger>
        </Label.Triggers>
      </Label>
    </Border>
    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnTapped" /></Grid.GestureRecognizers>
  </Grid>
</ContentView>
