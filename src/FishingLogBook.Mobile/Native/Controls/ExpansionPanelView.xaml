<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FishingLogBook.Mobile.Native.Controls.ExpansionPanelView"
             x:Name="Root">
  <ContentView.Content>
    <Border Style="{StaticResource Card}" Padding="0">
      <VerticalStackLayout>
        <Grid ColumnDefinitions="*,48" Padding="16,4,4,4" MinimumHeightRequest="56"
              SemanticProperties.Description="{Binding Title, Source={x:Reference Root}}"
              SemanticProperties.Hint="{Binding StateHint, Source={x:Reference Root}}">
          <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnHeaderTapped" />
          </Grid.GestureRecognizers>
          <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource Subheading}" VerticalOptions="Center"
                 SemanticProperties.HeadingLevel="Level2" />
          <Label x:Name="Chevron" Grid.Column="1" Text="⌄" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        </Grid>
        <BoxView Style="{StaticResource Divider}" IsVisible="{Binding IsExpanded, Source={x:Reference Root}}" />
        <ContentView x:Name="Body" Padding="16" IsVisible="{Binding IsExpanded, Source={x:Reference Root}}" />
      </VerticalStackLayout>
    </Border>
  </ContentView.Content>
</ContentView>
