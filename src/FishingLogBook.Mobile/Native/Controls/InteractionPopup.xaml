<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:FishingLogBook.Mobile.Interactions"
               xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
               x:Class="FishingLogBook.Mobile.Native.Controls.InteractionPopup"
               x:TypeArguments="x:Boolean" x:DataType="models:DialogRequest"
               Padding="0" Margin="20" MaximumWidthRequest="480" VerticalOptions="Center"
               BackgroundColor="Transparent">
  <Border Padding="20" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
          BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource DarkSurface}}" StrokeShape="RoundRectangle 16">
    <ScrollView VerticalOptions="Start">
      <VerticalStackLayout Spacing="16">
        <Border x:Name="IconCircle" WidthRequest="56" HeightRequest="56" StrokeThickness="0" HorizontalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
          <Border.StrokeShape><Ellipse /></Border.StrokeShape>
          <controls:IconView x:Name="DialogIcon" Source="icon_info.png" Tone="Accent" WidthRequest="26" HeightRequest="26" />
        </Border>
        <Label Text="{Binding Title}" Style="{StaticResource Subheading}" HorizontalTextAlignment="Center" AutomationId="DialogTitle" />
        <Label Text="{Binding Message}" HorizontalTextAlignment="Center" />
        <Button x:Name="AcceptButton" Text="{Binding Accept}" Clicked="OnAccept" AutomationId="DialogAccept" />
        <Button Text="{Binding Cancel}" Clicked="OnCancel" Style="{StaticResource SecondaryButton}" AutomationId="DialogCancel" />
      </VerticalStackLayout>
    </ScrollView>
  </Border>
</toolkit:Popup>
