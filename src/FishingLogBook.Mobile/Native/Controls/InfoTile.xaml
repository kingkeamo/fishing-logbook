<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FishingLogBook.Mobile.Native.Controls"
             x:Class="FishingLogBook.Mobile.Native.Controls.InfoTile"
             x:Name="Root">
  <Border Style="{StaticResource Card}" Padding="12" Shadow="{x:Null}" SemanticProperties.Description="{Binding Description, Source={x:Reference Root}}">
    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
    <Grid ColumnDefinitions="28,*" ColumnSpacing="10" VerticalOptions="Center">
      <controls:IconView Source="{Binding Icon, Source={x:Reference Root}}" Tone="Default" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
      <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
        <Label Text="{Binding Caption, Source={x:Reference Root}}" Style="{StaticResource TileCaption}" />
        <Label Text="{Binding Value, Source={x:Reference Root}}" Style="{StaticResource TileValue}" />
      </VerticalStackLayout>
    </Grid>
  </Border>
</ContentView>
