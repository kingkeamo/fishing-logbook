<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(IncludeIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <MobileEnvironment Condition="'$(MobileEnvironment)' == ''">Development</MobileEnvironment>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FishingLogBook.Mobile</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Catch</ApplicationTitle>
    <ApplicationId>com.fishinglogbook.mobile.demo</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' And '$(Configuration)' != 'Debug'">
    <ApplicationId>com.catchbutdontforget.app</ApplicationId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Xamarin.AndroidX.Browser" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel.OidcClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.13" />
    <PackageReference Include="Polly.Core" />
    <ProjectReference Include="../FishingLogBook.Client/FishingLogBook.Client.csproj" />
    <ProjectReference Include="../FishingLogBook.Shared/FishingLogBook.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Features\LocalPersistence\Sqlite\Migrations\*.sql" />
    <EmbeddedResource Include="Configuration\mobileauth.$(MobileEnvironment).json" LogicalName="FishingLogBook.Mobile.mobileauth.json" />
    <EmbeddedResource Include="../FishingLogBook.Web/Localization/FishingMethodStrings.resx" Link="Localization/FishingMethodStrings.resx" LogicalName="FishingLogBook.Mobile.Localization.FishingMethodStrings.resources" />
    <EmbeddedResource Include="../FishingLogBook.Web/Localization/FishingMethodStrings.fr.resx" Link="Localization/FishingMethodStrings.fr.resx" LogicalName="FishingLogBook.Mobile.Localization.FishingMethodStrings.fr.resources" />
    <EmbeddedResource Include="../FishingLogBook.Web/Localization/SpeciesStrings.resx" Link="Localization/SpeciesStrings.resx" LogicalName="FishingLogBook.Mobile.Localization.SpeciesStrings.resources" />
    <EmbeddedResource Include="../FishingLogBook.Web/Localization/SpeciesStrings.fr.resx" Link="Localization/SpeciesStrings.fr.resx" LogicalName="FishingLogBook.Mobile.Localization.SpeciesStrings.fr.resources" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <MauiImage Include="Resources/Images/*.svg" />
    <MauiImage Include="Resources/Images/*.jpg" Resize="True" BaseSize="480,360" />
    <MauiIcon Include="../FishingLogBook.Web/wwwroot/icon-512.png" Link="Resources/AppIcon/appicon.png" />
    <MauiSplashScreen Include="../FishingLogBook.Web/wwwroot/images/brand/brand-mark-transparent.png" Link="Resources/Splash/splash.png" Color="#E0F2FE" BaseSize="128,128" />
    <MauiImage Include="../FishingLogBook.Web/wwwroot/images/brand/brand-mark-transparent.png" Link="Resources/Images/brand_mark.png" Resize="True" BaseSize="256,256" />
    <MauiImage Include="../FishingLogBook.Web/wwwroot/images/brand/brand-horizontal-transparent.png" Link="Resources/Images/brand_horizontal.png" Resize="True" BaseSize="320,100" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App.xaml.cs;AppShell.xaml.cs;MauiProgram.cs;Platforms/**/*.cs;Features/**/Pages/**/*.cs;Features/**/Popups/**/*.cs;Features/**/Selectors/**/*.cs;Native/**/*.cs" />
  </ItemGroup>
</Project>
