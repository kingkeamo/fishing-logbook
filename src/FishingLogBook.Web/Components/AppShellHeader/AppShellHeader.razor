<MudAppBar Elevation="1" Dense="true">
    @MenuContent
    <MudLink Href="/"
             Underline="Underline.None"
             Color="Color.Inherit"
             Class="app-brand"
             aria-label="@Loc["App_Name"]"
             id="app-brand">
        <img src="images/brand/brand-mark-transparent.png" class="app-brand-mark" alt="" aria-hidden="true" id="app-brand-mark" />
        <MudText Typo="Typo.h6" Class="app-brand-name d-none d-sm-flex" id="app-brand-name">@Loc["App_Name"]</MudText>
    </MudLink>
    <MudSpacer />
    <MudTooltip Text="@Loc["OfflineDiagnostics_Title"]">
        <MudIconButton Icon="@Icons.Material.Filled.BugReport"
                       Color="Color.Inherit"
                       Href="/offline-diagnostics"
                       aria-label="@Loc["OfflineDiagnostics_Title"]"
                       title="@Loc["OfflineDiagnostics_Title"]"
                       id="offline-diagnostics-button" />
    </MudTooltip>
    <LanguageSwitcher />
    <MudIconButton Icon="@ThemeToggleIcon"
                   Color="Color.Inherit"
                   OnClick="OnToggleTheme"
                   aria-label="@ThemeToggleLabel"
                   id="theme-toggle-button" />
    @TrailingContent
</MudAppBar>
