@namespace FishingLogBook.Web.Components.AppErrorBoundary

<LoggingErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="app-error-boundary-container pa-4">
            <MudStack Spacing="2"
                      AlignItems="AlignItems.Center"
                      role="alert"
                      id="app-error-boundary">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline"
                         Color="Color.Error"
                         Size="Size.Medium"
                         aria-hidden="true"
                         id="app-error-boundary-icon" />
                <MudText Typo="Typo.h6"
                         Align="Align.Center"
                         id="app-error-boundary-title">
                    @Loc["App_UnhandledErrorTitle"]
                </MudText>
                <MudText Typo="Typo.body2"
                         Align="Align.Center"
                         Class="mud-text-secondary"
                         id="app-error-boundary-message">
                    @Loc["App_UnhandledErrorMessage"]
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="TryAgain"
                           id="app-error-boundary-try-again">
                    @Loc["Action_TryAgain"]
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           OnClick="GoHome"
                           id="app-error-boundary-go-home">
                    @Loc["Action_GoHome"]
                </MudButton>
            </MudStack>
        </MudContainer>
    </ErrorContent>
</LoggingErrorBoundary>
