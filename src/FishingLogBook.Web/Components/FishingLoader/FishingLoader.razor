@using FishingLogBook.Shared.Enums
<div class="@CssClass" role="status" aria-label="@AccessibleLabel" @attributes="AdditionalAttributes">
    @switch (_resolvedKind)
    {
        case LoaderKindEnum.Boat:
            <svg viewBox="0 0 96 96" aria-hidden="true" focusable="false">
                <path class="wake" d="M4 80c10-5 18 5 28 0s18 5 28 0 18 5 28 0" />
                <g class="craft">
                    <path class="hull-body" d="M30 54 L30 68 C44 76 66 74 82 58 L88 42 C76 38 58 48 34 52 Z" />
                    <path class="bow-rod" d="M76 48 C 90 30, 104 16, 118 10" />
                    <path class="bow-line" d="M118 10 Q 124 26 118 40" />
                    <circle class="head" cx="40" cy="34" r="5.5" />
                    <path class="body" d="M40 39 Q38 46 36 54 L50 54 Q48 46 40 39 Z" />
                    <path class="arm" d="M38 44 L26 52" />
                    <ellipse class="cowling" cx="24" cy="56" rx="6.5" ry="7.5" />
                    <ellipse class="lower" cx="24" cy="66" rx="3.2" ry="4.5" />
                    <ellipse class="prop" cx="24" cy="72" rx="5" ry="1.6" />
                </g>
            </svg>
            break;
        case LoaderKindEnum.Bobber:
            <svg viewBox="0 0 96 96" aria-hidden="true" focusable="false">
                <path class="water" d="M0 54c12-7 20 7 32 0s20 7 32 0 20 7 32 0" />
                <g class="rig">
                    <path class="from-rod" d="M14 -10 Q 28 6 48 16" />
                    <rect class="antenna" x="46.5" y="14" width="3" height="10" rx="1.2" />
                    <path class="pencil-white" d="M45.5 22 h5 v20 h-5 z" />
                    <path class="pencil-green" d="M45.5 42 h5 v12 L48 62 L45.5 54 z" />
                    <path class="leader" d="M48 62 Q 49 69 48 73" />
                    <path class="hook" d="M48 73 v5 a2.8 2.8 0 1 0 4-1.2" />
                    <path class="worm" d="M50 77 q 2.5 1.2 1.5 3.2 q -2.8 1.6 -0.5 3.2" />
                </g>
                <g class="taker">
                    <ellipse cx="0" cy="0" rx="11" ry="5" />
                    <polygon points="-9,0 -18,-5 -18,5" />
                    <circle cx="6" cy="-1.8" r="1.2" class="eye" />
                </g>
            </svg>
            break;
        default:
            <svg viewBox="0 0 96 96" aria-hidden="true" focusable="false">
                <path class="water" d="M8 70c8-6 16 6 24 0s16 6 24 0 16 6 24 0 16 6 24 0" />
                <path class="water delayed" d="M8 78c8-5 16 5 24 0s16 5 24 0 16 5 24 0 16 5 24 0" />
                <ellipse class="splash leave" cx="20" cy="70" rx="8" ry="3" />
                <ellipse class="splash land" cx="76" cy="70" rx="8" ry="3" />
                <g class="jumper">
                    <ellipse cx="0" cy="0" rx="14" ry="7" />
                    <polygon points="-12,0 -22,-5 -22,5" />
                    <circle cx="7" cy="-2" r="1.4" class="eye" />
                </g>
            </svg>
            break;
    }
</div>
