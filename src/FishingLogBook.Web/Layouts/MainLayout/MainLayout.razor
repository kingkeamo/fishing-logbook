@using FishingLogBook.Web.Features.Trips.Components.ActiveTripBanner
@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppShellHeader IsDarkMode="_isDarkMode" OnToggleTheme="ToggleDarkMode">
        <MenuContent>
            <AuthorizeView>
                <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               Class="d-md-none"
                               OnClick="ToggleDrawer"
                               aria-label="@Loc["Nav_Menu"]"
                               id="app-menu-button" />
                </Authorized>
            </AuthorizeView>
        </MenuContent>
        <TrailingContent>
        <UserMenu />
        </TrailingContent>
    </AppShellHeader>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen"
                       Variant="DrawerVariant.Responsive"
                       Breakpoint="@NavigationBreakpoint"
                       ClipMode="DrawerClipMode.Always"
                       Elevation="1"
                       id="app-drawer">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" id="home-nav-link">@Loc["Nav_Home"]</MudNavLink>
                    <MudNavLink Href="/catches/record" Icon="@Icons.Material.Filled.AddAPhoto" id="record-catch-nav-link">@Loc["Catch_RecordNav"]</MudNavLink>
                    <MudNavLink Href="/catches" Icon="@Icons.Material.Filled.MenuBook" id="catch-logbook-nav-link">@Loc["Catch_LogbookNav"]</MudNavLink>
                    <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person" id="profile-nav-link">@Loc["Profile_Nav"]</MudNavLink>
                    <MudNavLink Href="/install" Icon="@Icons.Material.Filled.InstallMobile" id="install-nav-link">@Loc["Onboarding_InstallNav"]</MudNavLink>
                    <MudNavLink Href="/system-status" Icon="@Icons.Material.Filled.Info" id="system-status-nav-link">@Loc["Build_About"]</MudNavLink>
                    <MudNavLink Href="/diagnostics" Icon="@Icons.Material.Filled.BugReport" id="diagnostics-nav-button">@Loc["Diagnostics_Nav"]</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        <AuthorizeView>
            <Authorized>
                <AppUpdateBanner />
                <ActiveTripBanner />
            </Authorized>
        </AuthorizeView>
        <div class="app-shell-content" id="app-shell-content">
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </div>
    </MudMainContent>
</MudLayout>
