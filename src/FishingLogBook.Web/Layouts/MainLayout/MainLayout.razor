@inherits LayoutComponentBase
@using FishingLogBook.Web.Features.Authentication.Components.UserMenu

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Class="d-md-none"
                       OnClick="ToggleDrawer"
                       aria-label="@Loc["Nav_Menu"]"
                       id="app-menu-button" />
        <MudLink Href="/"
                 Underline="Underline.None"
                 Color="Color.Inherit"
                 Class="app-brand"
                 aria-label="@Loc["App_Name"]"
                 id="app-brand">
            <MudIcon Icon="@Icons.Material.Filled.Phishing" aria-hidden="true" id="app-brand-mark" />
            <MudText Typo="Typo.h6" Class="app-brand-name d-none d-sm-flex" id="app-brand-name">@Loc["App_Name"]</MudText>
        </MudLink>
        <MudSpacer />
        <LanguageSwitcher />
        <MudIconButton Icon="@ThemeToggleIcon"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode"
                       aria-label="@ThemeToggleLabel"
                       id="theme-toggle-button" />
        <UserMenu />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="@NavigationBreakpoint"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               id="app-drawer">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" id="home-nav-link">
                @Loc["Nav_Home"]
            </MudNavLink>
            <MudNavLink Href="/catches/record" Icon="@Icons.Material.Filled.AddAPhoto" id="record-catch-nav-link">
                @Loc["Catch_RecordNav"]
            </MudNavLink>
            <MudNavLink Href="/catches" Icon="@Icons.Material.Filled.MenuBook" id="catch-logbook-nav-link">
                @Loc["Catch_LogbookNav"]
            </MudNavLink>
            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person" id="profile-nav-link">
                @Loc["Profile_Nav"]
            </MudNavLink>
            <MudNavLink Href="/diagnostics" Icon="@Icons.Material.Filled.BugReport" id="diagnostics-nav-button">
                @Loc["Diagnostics_Nav"]
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <div class="app-shell-content" id="app-shell-content">
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </div>
    </MudMainContent>
</MudLayout>
