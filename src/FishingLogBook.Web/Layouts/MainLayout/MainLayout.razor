@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">@Loc["App_Name"]</MudText>
        <MudSpacer />
        <MudIconButton Href="/test-catch"
                       Icon="@Icons.Material.Filled.Phishing"
                       Color="Color.Inherit"
                       aria-label="@Loc["TestCatch_Nav"]"
                       id="test-catch-nav-button" />
        <MudButton Href="/diagnostics"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.BugReport"
                   id="diagnostics-nav-button">
            @Loc["Diagnostics_Nav"]
        </MudButton>
        <LanguageSwitcher />
        <LoginDisplay />
        <MudIconButton Icon="@ThemeToggleIcon"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       OnClick="ToggleDarkMode"
                       aria-label="@ThemeToggleLabel"
                       id="theme-toggle-button" />
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
