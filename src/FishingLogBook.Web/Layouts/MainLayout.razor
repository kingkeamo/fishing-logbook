@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">@Loc["App_Name"]</MudText>
        <MudSpacer />
        <MudIconButton Href="/test-catch"
                       Icon="@Icons.Material.Filled.Phishing"
                       Color="Color.Inherit"
                       aria-label="@Loc["TestCatch_Nav"]"
                       id="test-catch-nav-button" />
        @if (DiagnosticsConfig.ShowInspector)
        {
            <MudIconButton Href="/diagnostics"
                           Icon="@Icons.Material.Filled.BugReport"
                           Color="Color.Inherit"
                           aria-label="@Loc["Diagnostics_Nav"]"
                           id="diagnostics-nav-button" />
        }
        <LanguageSwitcher />
        <MudIconButton Icon="@ThemeToggleIcon"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       OnClick="ToggleDarkMode"
                       aria-label="@ThemeToggleLabel"
                       id="theme-toggle-button" />
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
