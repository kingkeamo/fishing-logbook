@page "/"

<PageTitle>FishingLogBook - System Status</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="status-container pa-4">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Phishing" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Align="Align.Center">FishingLogBook</MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mud-text-secondary">System status</MudText>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <StatusRow Label="Web" State="_webStatus" />
                <MudDivider />
                <StatusRow Label="API" State="_apiStatus" />
                <MudDivider />
                <StatusRow Label="Database" State="_databaseStatus" DetailText="@_databaseName" />
            </MudStack>
        </MudPaper>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_isChecking"
                   OnClick="RefreshAsync"
                   id="refresh-status-button">
            Refresh
        </MudButton>
    </MudStack>
</MudContainer>
