@page "/"

<PageTitle>@Loc["Landing_PageTitle"]</PageTitle>

<main class="landing-page" id="public-landing-page">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="landing-content">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <img src="images/brand/brand-horizontal-transparent.png" class="landing-logo" alt="@Loc["Brand_LogoAlt"]" id="landing-brand-logo" />
            <MudText Typo="Typo.h5" Align="Align.Center" Class="landing-tagline">@Loc["Landing_Tagline"]</MudText>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="landing-heading">@Loc["Landing_Heading"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="landing-introduction">@Loc["Landing_Introduction"]</MudText>
            <MudGrid Justify="Justify.Center" Class="landing-benefits">
                <MudItem xs="12" sm="4">
                    <MudPaper Class="landing-benefit pa-4" Elevation="0"><MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Color="Color.Primary" Size="Size.Large" aria-hidden="true" /><MudText Typo="Typo.subtitle1">@Loc["Landing_BenefitRecord"]</MudText></MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="landing-benefit pa-4" Elevation="0"><MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" aria-hidden="true" /><MudText Typo="Typo.subtitle1">@Loc["Landing_BenefitPrivate"]</MudText></MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="landing-benefit pa-4" Elevation="0"><MudIcon Icon="@Icons.Material.Filled.SignalWifiOff" Color="Color.Primary" Size="Size.Large" aria-hidden="true" /><MudText Typo="Typo.subtitle1">@Loc["Landing_BenefitOffline"]</MudText></MudPaper>
                </MudItem>
            </MudGrid>
            <MudStack Spacing="2" Class="landing-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="BeginCreateAccount" id="landing-create-account">@Loc["Auth_CreateAccount"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="BeginSignIn" id="landing-sign-in">@Loc["Auth_SignIn"]</MudButton>
                @if (_offlineAvailability == OfflineAvailabilityState.Ready)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="_unlocking"
                               OnClick="OpenOfflineAsync"
                               StartIcon="@Icons.Material.Filled.LockOpen"
                               id="landing-open-offline">
                        @Loc["OfflineAccess_OpenOffline"]
                    </MudButton>
                }
                @if (_offlineAvailability == OfflineAvailabilityState.CheckFailed)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" id="landing-offline-availability-failed">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2">@Loc["OfflineAccess_AvailabilityCheckFailed"]</MudText>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Disabled="_checkingOfflineAvailability"
                                       OnClick="RetryOfflineAvailabilityAsync"
                                       id="landing-offline-availability-retry">
                                @Loc["Action_TryAgain"]
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }
                @if (_offlineUnlockFailed)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" id="landing-offline-error">
                        @Loc["OfflineAccess_UnlockFailed"]
                    </MudAlert>
                }
            </MudStack>
        </MudStack>
    </MudContainer>
</main>
