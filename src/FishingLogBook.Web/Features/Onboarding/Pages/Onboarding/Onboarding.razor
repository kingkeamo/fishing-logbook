@page "/onboarding"
@using Microsoft.AspNetCore.Authorization
@using FishingLogBook.Shared.Enums
@attribute [Authorize]

<PageTitle>@Loc["Onboarding_PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Gutters="false" Class="onboarding-container">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-block ma-auto" id="onboarding-loading" />
    }
    else
    {
        <MudPaper Class="pa-4 pa-sm-6" Elevation="2">
            <MudStack Spacing="3">
                <img src="images/brand/brand-horizontal.png" class="onboarding-logo" alt="@Loc["Brand_LogoAlt"]" />
                <MudStepper @bind-ActiveIndex="_activeStep" NonLinear="false" ShowResetButton="false" Class="onboarding-stepper">
                    <ChildContent>
                        <MudStep Title="@Loc["Onboarding_WelcomeStep"]">
                            <MudStack Spacing="2" Class="py-4">
                                <MudText Typo="Typo.h4">@Loc["Onboarding_WelcomeTitle"]</MudText>
                                <MudText>@Loc["Onboarding_WelcomeBody"]</MudText>
                            </MudStack>
                        </MudStep>
                        <MudStep Title="@Loc["Onboarding_PreferencesStep"]">
                            <MudStack Spacing="3" Class="py-4">
                                <MudText Typo="Typo.h5">@Loc["Onboarding_PreferencesTitle"]</MudText>
                                <MudText>@Loc["Onboarding_PreferencesBody"]</MudText>
                                <MudSelect T="WeightUnitEnum" @bind-Value="_weightUnit" Label="@Loc["Profile_WeightUnit"]" Variant="Variant.Outlined" id="onboarding-weight-unit">
                                    <MudSelectItem Value="WeightUnitEnum.Kg">@Loc["Profile_WeightUnit_Kg"]</MudSelectItem>
                                    <MudSelectItem Value="WeightUnitEnum.Lb">@Loc["Profile_WeightUnit_Lb"]</MudSelectItem>
                                </MudSelect>
                                <MudSelect T="LengthUnitEnum" @bind-Value="_lengthUnit" Label="@Loc["Profile_LengthUnit"]" Variant="Variant.Outlined" id="onboarding-length-unit">
                                    <MudSelectItem Value="LengthUnitEnum.Cm">@Loc["Profile_LengthUnit_Cm"]</MudSelectItem>
                                    <MudSelectItem Value="LengthUnitEnum.In">@Loc["Profile_LengthUnit_In"]</MudSelectItem>
                                </MudSelect>
                            </MudStack>
                        </MudStep>
                        <MudStep Title="@Loc["Onboarding_LocationStep"]">
                            <MudStack Spacing="3" Class="py-4">
                                <MudText Typo="Typo.h5">@Loc["Onboarding_LocationTitle"]</MudText>
                                <MudText>@Loc["Onboarding_LocationBody"]</MudText>
                                <MudAlert Severity="Severity.Info">@Loc["Onboarding_LocationPrivacy"]</MudAlert>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AllowLocationAsync" Disabled="_locationHandled" id="onboarding-allow-location">@Loc["Onboarding_AllowLocation"]</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="SkipLocationAsync" Disabled="_locationHandled" id="onboarding-skip-location">@Loc["Action_NotNow"]</MudButton>
                                @if (_locationHandled)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success" id="onboarding-location-handled">@Loc["Onboarding_LocationHandled"]</MudText>
                                }
                            </MudStack>
                        </MudStep>
                        <MudStep Title="@Loc["Onboarding_InstallStep"]">
                            <MudStack Spacing="3" Class="py-4">
                                <MudText Typo="Typo.h5">@Loc["Onboarding_InstallTitle"]</MudText>
                                @if (_installState.IsInstalled)
                                {
                                    <MudAlert Severity="Severity.Success">@Loc["Onboarding_AlreadyInstalled"]</MudAlert>
                                }
                                else if (_installState.CanPrompt)
                                {
                                    <MudText>@Loc["Onboarding_InstallPromptBody"]</MudText>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync" id="onboarding-install">@Loc["Onboarding_InstallAction"]</MudButton>
                                }
                                else if (_installState.IsIos)
                                {
                                    <MudText>@Loc["Onboarding_InstallIos"]</MudText>
                                }
                                else if (_installState.IsAndroid)
                                {
                                    <MudText>@Loc["Onboarding_InstallAndroid"]</MudText>
                                }
                                else
                                {
                                    <MudText>@Loc["Onboarding_InstallUnavailable"]</MudText>
                                }
                            </MudStack>
                        </MudStep>
                    </ChildContent>
                    <ActionContent></ActionContent>
                </MudStepper>

                @if (_saveFailed)
                {
                    <MudAlert Severity="Severity.Error" id="onboarding-save-failed">@Loc["Onboarding_SaveFailed"]</MudAlert>
                }
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    @if (_activeStep > 0)
                    {
                        <MudButton Variant="Variant.Text" OnClick="Previous" id="onboarding-previous">@Loc["Action_Back"]</MudButton>
                    }
                    @if (_activeStep < 3)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextAsync" Disabled="@(_isSaving || (_activeStep == 2 && !_locationHandled))" id="onboarding-next">@Loc["Action_Next"]</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinishAsync" Disabled="_isSaving" id="onboarding-finish">@Loc["Onboarding_Finish"]</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudContainer>
