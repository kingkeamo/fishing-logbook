@namespace FishingLogBook.Web.Features.Profile.Components.FishingLocationsEditor
@using FishingLogBook.Shared.Constants

<MudStack Spacing="1" id="fishing-locations-editor">
    <MudText Typo="Typo.subtitle2">@Loc["Profile_FishingLocations"]</MudText>

    @if (Locations.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary" id="fishing-locations-empty">
            @Loc["Profile_FishingLocations_None"]
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @Loc["Profile_FishingLocation_SetDefaultHint"]
        </MudText>
        <MudStack Row="true" Spacing="1" Class="flex-wrap" id="fishing-locations-list">
            @foreach (var location in Locations)
            {
                <span class="location-pill @(location.IsDefault ? "location-pill-secondary" : "location-pill-primary")"
                      id="@ItemId(location)">
                    <MudChip T="string"
                             Color="@(location.IsDefault ? Color.Secondary : Color.Primary)"
                             Variant="Variant.Filled"
                             Icon="@(location.IsDefault ? Icons.Material.Filled.Star : null)"
                             aria-label="@SetDefaultLabel(location)"
                             OnClick="@(() => SetDefaultAsync(location))"
                             id="@($"{ItemId(location)}-set-default")">
                        @location.Name
                        @if (location.IsDefault)
                        {
                            <span class="profile-default-label"
                                  id="@($"{ItemId(location)}-default")">&#160;@Loc["Profile_FishingLocation_Default"]</span>
                        }
                    </MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   Class="location-pill-remove"
                                   aria-label="@RemoveLabel(location)"
                                   OnClick="@(() => RemoveAsync(location))"
                                   id="@($"{ItemId(location)}-remove")" />
                </span>
            }
        </MudStack>
    }

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="fishing-locations-add">
        <MudTextField @bind-Value="_newLocationName"
                      Label="@Loc["Profile_FishingLocation_Add"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      MaxLength="FishingLocationConstants.MaxNameLength"
                      Error="@(_error is not null)"
                      ErrorText="@_error"
                      OnKeyDown="OnAddKeyDownAsync"
                      Class="fishing-locations-add-input"
                      id="fishing-location-new-name" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="fishing-locations-add-button"
                   OnClick="AddAsync"
                   id="fishing-location-add">
            @Loc["Profile_FishingLocation_AddAction"]
        </MudButton>
    </MudStack>
</MudStack>
