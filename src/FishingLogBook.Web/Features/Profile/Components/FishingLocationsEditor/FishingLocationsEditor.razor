@namespace FishingLogBook.Web.Features.Profile.Components.FishingLocationsEditor
@using FishingLogBook.Shared.Constants

<MudStack Spacing="2" id="fishing-locations-editor">
    <MudText Typo="Typo.subtitle2">@Loc["Profile_FishingLocations"]</MudText>

    @if (Locations.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary" id="fishing-locations-empty">
            @Loc["Profile_FishingLocations_None"]
        </MudText>
    }
    else
    {
        <MudStack Spacing="1" Class="fishing-locations-list" id="fishing-locations-list">
            @foreach (var location in Locations)
            {
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Justify="Justify.SpaceBetween"
                          Class="fishing-locations-item"
                          id="@ItemId(location)">
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2"
                              Class="fishing-locations-name-group">
                        <MudText Typo="Typo.body1" Class="fishing-locations-name">@location.Name</MudText>
                        @if (location.IsDefault)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     Variant="Variant.Filled"
                                     Icon="@Icons.Material.Filled.Star"
                                     id="@($"{ItemId(location)}-default")">
                                @Loc["Profile_FishingLocation_Default"]
                            </MudChip>
                        }
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (!location.IsDefault)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.StarBorder"
                                       aria-label="@SetDefaultLabel(location)"
                                       OnClick="@(() => SetDefaultAsync(location))"
                                       id="@($"{ItemId(location)}-set-default")">
                                @Loc["Profile_FishingLocation_SetDefault"]
                            </MudButton>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Medium"
                                       Color="Color.Inherit"
                                       aria-label="@RemoveLabel(location)"
                                       OnClick="@(() => RemoveAsync(location))"
                                       id="@($"{ItemId(location)}-remove")" />
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    }

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="fishing-locations-add">
        <MudTextField @bind-Value="_newLocationName"
                      Label="@Loc["Profile_FishingLocation_Add"]"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      MaxLength="FishingLocationConstants.MaxNameLength"
                      Error="@(_error is not null)"
                      ErrorText="@_error"
                      OnKeyUp="OnAddKeyUpAsync"
                      Class="fishing-locations-add-input"
                      id="fishing-location-new-name" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddAsync"
                   id="fishing-location-add">
            @Loc["Profile_FishingLocation_AddAction"]
        </MudButton>
    </MudStack>
</MudStack>
