@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using FishingLogBook.Shared.Dtos
@using FishingLogBook.Shared.Enums
@attribute [Authorize]

<PageTitle>@Loc["Profile_PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Gutters="false" Class="profile-container">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" Align="Align.Center">@Loc["Profile_Title"]</MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mud-text-secondary">@Loc["Profile_Subtitle"]</MudText>
        </MudStack>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="profile-load-failed">@Loc["Profile_LoadFailed"]</MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center" id="profile-loading" />
        }
        else
        {
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_displayName"
                                  Label="@Loc["Profile_DisplayName"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  id="profile-display-name" />
                    <MudSwitch @bind-Value="_showDisplayName"
                               Color="Color.Primary"
                               Label="@Loc["Profile_ShowDisplayName"]"
                               id="profile-show-display-name" />

                    <MudTextField @bind-Value="_homeRegion"
                                  Label="@Loc["Profile_HomeRegion"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  id="profile-home-region" />
                    <MudSwitch @bind-Value="_showHomeRegion"
                               Color="Color.Primary"
                               Label="@Loc["Profile_ShowHomeRegion"]"
                               id="profile-show-home-region" />

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">@Loc["Profile_FishingMethods"]</MudText>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap" id="profile-method-chips">
                            @foreach (var method in MethodChips)
                            {
                                var selected = IsMethodSelected(method.Id);
                                <MudChip T="string"
                                         Color="@(selected ? Color.Primary : Color.Default)"
                                         Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ToggleMethod(method))"
                                         id="@($"profile-method-{method.Code}")">
                                    @method.Name
                                </MudChip>
                            }
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddMethodAsync"
                                       id="profile-method-more">
                                @Loc["Common_More"]
                            </MudButton>
                        </MudStack>
                        @if (_selectedMethods.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Profile_FishingMethod_SetDefault"]</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap" id="profile-method-default-chips">
                                @foreach (var method in _selectedMethods)
                                {
                                    <MudChip T="string"
                                             Color="@(method.IsDefault ? Color.Secondary : Color.Default)"
                                             Variant="@(method.IsDefault ? Variant.Filled : Variant.Outlined)"
                                             Icon="@(method.IsDefault ? Icons.Material.Filled.Star : null)"
                                             OnClick="@(() => SetDefaultMethod(method.FishingMethodId))"
                                             id="@($"profile-method-default-{method.Code}")">
                                        @method.Name
                                        @if (method.IsDefault)
                                        {
                                            <span class="profile-default-label">&#160;@Loc["Profile_FishingMethod_Default"]</span>
                                        }
                                    </MudChip>
                                }
                            </MudStack>
                        }
                    </MudStack>

                    @foreach (var selectedMethod in _selectedMethods)
                    {
                        <MudStack Spacing="1" id="@($"profile-species-section-{selectedMethod.Code}")">
                            <MudText Typo="Typo.subtitle2">@string.Format(Loc["Profile_FishingMethod_Species"], selectedMethod.Name)</MudText>
                            @if (selectedMethod.Species.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Profile_FishingSpecies_SetDefault"]</MudText>
                            }
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                @foreach (var species in selectedMethod.Species)
                                {
                                    <MudChip T="string"
                                             Color="@(species.IsDefault ? Color.Secondary : Color.Primary)"
                                             Variant="Variant.Filled"
                                             Icon="@(species.IsDefault ? Icons.Material.Filled.Star : null)"
                                             OnClick="@(() => SetDefaultSpeciesForMethod(selectedMethod.FishingMethodId, species.SpeciesId))"
                                             id="@($"profile-species-{selectedMethod.Code}-{species.Code}")">
                                        @species.Name
                                        @if (species.IsDefault)
                                        {
                                            <span class="profile-default-label">&#160;@Loc["Profile_FishingMethod_Default"]</span>
                                        }
                                    </MudChip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   aria-label="@string.Format(Loc["Profile_FishingSpecies_Remove"], species.Name)"
                                                   OnClick="@(() => RemoveSpeciesFromMethod(selectedMethod.FishingMethodId, species.SpeciesId))"
                                                   id="@($"profile-species-remove-{selectedMethod.Code}-{species.Code}")" />
                                }
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => AddSpeciesToMethodAsync(selectedMethod.FishingMethodId))"
                                           id="@($"profile-species-more-{selectedMethod.Code}")">
                                    @Loc["Common_More"]
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    }

                    <MudSwitch @bind-Value="_showPreferredSpecies"
                               Color="Color.Primary"
                               Label="@Loc["Profile_ShowPreferredSpecies"]"
                               id="profile-show-preferred-species" />

                    <MudSelect T="WeightUnitEnum"
                               @bind-Value="_preferredWeightUnit"
                               Label="@Loc["Profile_WeightUnit"]"
                               Variant="Variant.Outlined"
                               id="profile-weight-unit">
                        <MudSelectItem Value="WeightUnitEnum.Kg">@Loc["Profile_WeightUnit_Kg"]</MudSelectItem>
                        <MudSelectItem Value="WeightUnitEnum.Lb">@Loc["Profile_WeightUnit_Lb"]</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="LengthUnitEnum"
                               @bind-Value="_preferredLengthUnit"
                               Label="@Loc["Profile_LengthUnit"]"
                               Variant="Variant.Outlined"
                               id="profile-length-unit">
                        <MudSelectItem Value="LengthUnitEnum.Cm">@Loc["Profile_LengthUnit_Cm"]</MudSelectItem>
                        <MudSelectItem Value="LengthUnitEnum.In">@Loc["Profile_LengthUnit_In"]</MudSelectItem>
                    </MudSelect>

                    <div class="profile-photo-actions">
                        <label for="profile-photo-input" class="profile-photo-picker" id="profile-choose-photo">
                            @Loc["Profile_ChoosePhoto"]
                        </label>
                        <InputFile OnChange="OnPhotographSelected"
                                   accept="image/jpeg,image/png,image/webp"
                                   class="profile-photo-input"
                                   id="profile-photo-input" />
                    </div>
                    @if (_photographUrl is not null)
                    {
                        <img src="@_photographUrl"
                             alt="@Loc["Profile_PhotographAlt"]"
                             class="profile-photo-preview"
                             id="profile-photo-preview" />
                    }
                    <MudSwitch @bind-Value="_showPhotograph"
                               Color="Color.Primary"
                               Label="@Loc["Profile_ShowPhotograph"]"
                               id="profile-show-photograph" />

                    <MudText Typo="Typo.caption" id="profile-privacy-caption">@Loc["Profile_LocationPrivacy"]</MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@_isSaving"
                               OnClick="SaveAsync"
                               id="profile-save-button">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Inherit"
                                                 Class="me-2"
                                                 id="profile-save-spinner" />
                            @Loc["Profile_Saving"]
                        }
                        else
                        {
                            @Loc["Profile_Save"]
                        }
                    </MudButton>
                    @if (_saveFailed)
                    {
                        <MudAlert Severity="Severity.Error" id="profile-save-failed">@Loc["Profile_SaveFailed"]</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>
