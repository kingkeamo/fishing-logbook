@namespace FishingLogBook.Web.Features.Trips.Components.TripTimeline
@using FishingLogBook.Web.Features.Trips.Enums

@if (Items.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary" id="trip-timeline-empty">
        @Loc["Trip_TimelineEmpty"]
    </MudText>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Start"
                 TimelineOrientation="TimelineOrientation.Vertical"
                 Class="trip-timeline"
                 id="trip-timeline">
        @for (var index = 0; index < Items.Count; index++)
        {
            var item = Items[index];
            var showDate = ShowDate(index);
            <MudTimelineItem Icon="@IconFor(item.Kind)"
                             Color="@ColourFor(item.Kind)"
                             Size="Size.Small"
                             Elevation="0"
                             id="@ItemId(item)">
                <ItemContent>
                    <MudStack Spacing="1" Class="trip-timeline-entry">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary trip-timeline-time">
                                @TimeLabel(item, showDate)
                            </MudText>
                            @if (ContributorName(item) is { } contributor)
                            {
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary trip-timeline-contributor"
                                         id="@($"{ItemId(item)}-contributor")">
                                    @contributor
                                </MudText>
                            }
                        </MudStack>

                        @switch (item.Kind)
                        {
                            case TripTimelineKindEnum.Photograph:
                                @if (MediaSource(item) is { } photographSource)
                                {
                                    <img src="@photographSource"
                                         alt="@Loc["Trip_Timeline_PhotographDescription"]"
                                         class="trip-timeline-photograph"
                                         id="@($"{ItemId(item)}-media")" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @Loc["Trip_Timeline_PhotographDescription"]
                                    </MudText>
                                }

                                break;

                            case TripTimelineKindEnum.Catch:
                                <MudPaper Elevation="0" Class="trip-timeline-catch" id="@($"{ItemId(item)}-catch")">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        @if (MediaSource(item) is { } catchSource)
                                        {
                                            <img src="@catchSource"
                                                 alt="@SpeciesLabel(item)"
                                                 class="trip-timeline-catch-thumbnail"
                                                 id="@($"{ItemId(item)}-media")" />
                                        }
                                        <MudStack Spacing="0" Class="trip-timeline-catch-detail">
                                            <MudText Typo="Typo.subtitle2"
                                                     Class="trip-timeline-catch-species">@SpeciesLabel(item)</MudText>
                                            @if (MeasurementsLabel(item) is { } measurements)
                                            {
                                                <MudText Typo="Typo.body2"
                                                         Class="mud-text-secondary"
                                                         id="@($"{ItemId(item)}-measurements")">@measurements</MudText>
                                            }
                                        </MudStack>
                                        @if (CatchHref(item) is { } href)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                           Size="Size.Small"
                                                           Href="@href"
                                                           aria-label="@SpeciesLabel(item)"
                                                           id="@($"{ItemId(item)}-link")" />
                                        }
                                    </MudStack>
                                </MudPaper>

                                break;

                            case TripTimelineKindEnum.Note:
                                <MudStack Row="true"
                                          Spacing="1"
                                          AlignItems="AlignItems.Start"
                                          Justify="Justify.SpaceBetween"
                                          Class="trip-timeline-note">
                                    <MudText Typo="Typo.body2"
                                             Class="trip-timeline-note-text">@item.Text</MudText>
                                    @if (CanEditNotes && IsOwnContribution(item) && item.NoteId is { } noteId)
                                    {
                                        <MudStack Row="true" Spacing="0" Class="trip-timeline-note-actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Color="Color.Inherit"
                                                           Class="trip-timeline-note-action"
                                                           aria-label="@Loc["Trip_NoteEdit"]"
                                                           title="@Loc["Trip_NoteEdit"]"
                                                           OnClick="@(() => OnEditNote.InvokeAsync(item))"
                                                           id="@($"trip-timeline-note-edit-{noteId:D}")" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Inherit"
                                                           Class="trip-timeline-note-action trip-timeline-note-remove"
                                                           aria-label="@Loc["Trip_NoteRemove"]"
                                                           title="@Loc["Trip_NoteRemove"]"
                                                           OnClick="@(() => OnDeleteNote.InvokeAsync(noteId))"
                                                           id="@($"trip-timeline-note-remove-{noteId:D}")" />
                                        </MudStack>
                                    }
                                </MudStack>

                                break;

                            default:
                                <MudText Typo="Typo.subtitle2">@Description(item)</MudText>

                                break;
                        }
                    </MudStack>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}
