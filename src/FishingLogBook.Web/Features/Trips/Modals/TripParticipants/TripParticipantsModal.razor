@namespace FishingLogBook.Web.Features.Trips.Modals.TripParticipants
@using FishingLogBook.Web.Features.Trips.Components.TripParticipants

<MudDialog id="trip-participants-modal">
    <TitleContent>
        <MudText Typo="Typo.h6" id="trip-participants-modal-title">@Loc["Trip_Participants"]</MudText>
    </TitleContent>
    <DialogContent>
        <TripParticipants TripId="Model.TripId" Changed="OnChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close" id="trip-participants-close">@Loc["Modal_Close"]</MudButton>
    </DialogActions>
</MudDialog>