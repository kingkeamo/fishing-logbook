@namespace FishingLogBook.Web.Features.Import.Modals.PlaceName

<MudDialog id="place-name-modal">
    <TitleContent>
        <MudText Typo="Typo.h6" id="place-name-modal-title">@Loc["Import_LocationDetails"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">@Loc["Import_LocationDetailsHelp"]</MudText>
            @for (var index = 0; index < _components.Count; index++)
            {
                var component = _components[index];
                <MudCheckBox T="bool"
                             Value="@_selected.Contains(component)"
                             ValueChanged="@(selected => SetSelected(component, selected))"
                             Label="@component"
                             id="@($"place-name-component-{index}")" />
            }
            <MudText Typo="Typo.subtitle2">@Loc["Import_LocationPreview"]</MudText>
            <MudText id="place-name-preview">@(Preview ?? Loc["Import_NoPlaceName"])</MudText>
            @if (!IsValid)
            {
                <MudAlert Severity="Severity.Error" Dense="true" id="place-name-too-long">
                    @Loc["Import_PlaceNameTooLong"]
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" id="place-name-cancel">@Loc["Modal_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply" Disabled="@(!IsValid)"
                   id="place-name-apply">@Loc["Catch_MeasurementApply"]</MudButton>
    </DialogActions>
</MudDialog>
