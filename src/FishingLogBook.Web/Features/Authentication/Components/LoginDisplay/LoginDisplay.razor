<AuthorizeView>
    <Authorized>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   OnClick="BeginSignOut"
                   id="auth-sign-out-button">
            @Loc["Auth_SignOut"]
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   OnClick="BeginSignIn"
                   id="auth-sign-in-button">
            @Loc["Auth_SignIn"]
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   OnClick="BeginSignIn"
                   id="auth-create-account-button">
            @Loc["Auth_CreateAccount"]
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
