<AuthorizeView>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (GetEmail(context.User) is { } email)
            {
                <MudText Typo="Typo.body2"
                         id="auth-current-user-email"
                         Class="auth-current-user-email">
                    @email
                </MudText>
            }
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       OnClick="BeginSignOut"
                       id="auth-sign-out-button">
                @Loc["Auth_SignOut"]
            </MudButton>
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   OnClick="BeginSignIn"
                   id="auth-sign-in-button">
            @Loc["Auth_SignIn"]
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   OnClick="BeginSignIn"
                   id="auth-create-account-button">
            @Loc["Auth_CreateAccount"]
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
