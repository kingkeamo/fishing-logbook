@namespace FishingLogBook.Web.Features.Catch.Components.CatchPhotographCarousel

<div class="@ContainerClass"
     tabindex="0"
     role="region"
     aria-label="@CurrentPhotographAlt"
     @onkeydown="OnKeyDownAsync"
     @onpointerdown="OnPointerDown"
     @onpointerup="OnPointerUpAsync">
    <div class="catch-photograph-carousel-media">
        @if (CurrentPhotoUrl is not null)
        {
            <MudImage Src="@CurrentPhotoUrl"
                      Alt="@CurrentPhotographAlt"
                      ObjectFit="ObjectFit.Cover"
                      Fluid="true"
                      Class="catch-photograph-carousel-photo"
                      data-photograph-id="@CurrentPhotographId"
                      id="@PhotoElementId" />
        }
        else
        {
            <div class="catch-photograph-carousel-placeholder"
                 role="img"
                 aria-label="@Loc["Catch_NoPhotograph"]"
                 id="@NoPhotoElementId">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
                         aria-hidden="true" />
            </div>
        }
    </div>

    @if (ShowNavigationRow)
    {
        <div class="catch-photograph-carousel-navigation"
             id="@NavigationElementId">

            @if (HasMultiplePhotographs)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Size="Size.Small"
                               OnClick="PreviousPhotographAsync"
                               aria-label="@Loc["Catch_PreviousPhoto"]"
                               id="@PreviousElementId" />
            }

            @if (HasMultiplePhotographs || (ShowSinglePhotographCount && PhotographCount == 1))
            {
                <MudText Typo="Typo.caption"
                         Class="catch-photograph-carousel-count"
                         id="@CountElementId">
                    @Loc["Catch_PhotoPosition", CurrentPhotographNumber, PhotographCount]
                </MudText>
            }

            @if (HasMultiplePhotographs)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Size="Size.Small"
                               OnClick="NextPhotographAsync"
                               aria-label="@Loc["Catch_NextPhoto"]"
                               id="@NextElementId" />
            }

            @if (Editable && PhotographCount > 0)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="RemoveCurrentPhotographAsync"
                               aria-label="@Loc["Catch_RemovePhoto"]"
                               id="@RemoveElementId" />
            }
        </div>
    }
</div>
