@using FishingLogBook.Web.Common.Icons
@using Microsoft.AspNetCore.Components.Forms
@using FishingLogBook.Web.Features.Catch.Components.MeasurementEditor

<PageTitle>@Loc["Catch_RecordPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false" Class="record-catch-container">
    <MudStack Spacing="2" AlignItems="AlignItems.Stretch">
        <MudText Typo="Typo.h6" Align="Align.Center" id="record-catch-title">@Loc["Catch_RecordTitle"]</MudText>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center"
                                 id="record-catch-loading" />
        }
        else
        {
            <MudPaper Class="pa-3" Elevation="2">
                <MudStack Spacing="2">
                    @if (_catalogueUnavailable)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary"
                                 id="record-catch-catalogue-unavailable">
                            @Loc["Catch_CatalogueUnavailable"]
                        </MudText>
                    }

                    <MudStack Spacing="2">
                        <MudText Typo="Typo.caption">@Loc["Catch_EditMethod"]</MudText>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap" id="record-catch-method-chips">
                            @foreach (var method in MethodOptions)
                            {
                                var selected = string.Equals(method.Name, _selectedMethod, StringComparison.OrdinalIgnoreCase);
                                <MudChip T="string"
                                         Color="@(selected ? Color.Primary : Color.Default)"
                                         Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => SelectMethod(method.Name))"
                                         id="@($"record-catch-method-{method.Code}")">
                                    @method.Name
                                </MudChip>
                            }
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       OnClick="ChooseMethodAsync"
                                       id="record-catch-method-more">
                                @Loc["Common_More"]
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudStack Spacing="2">
                        <MudText Typo="Typo.caption">@Loc["Catch_EditSpecies"]</MudText>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap" id="record-catch-species-chips">
                            @foreach (var species in SpeciesOptions)
                            {
                                var selected = string.Equals(species.Name, _selectedSpecies, StringComparison.OrdinalIgnoreCase);
                                <MudChip T="string"
                                         Color="@(selected ? Color.Primary : Color.Default)"
                                         Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => SelectSpecies(species.Name))"
                                         id="@($"record-catch-species-{species.Code}")">
                                    @species.Name
                                </MudChip>
                            }
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       OnClick="ChooseSpeciesAsync"
                                       id="record-catch-species-more">
                                @Loc["Common_More"]
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_photographs.Count > 0)
                    {
                        <div id="catch-photo-carousel">
                            <PhotographCarousel Photographs="CarouselPhotographs"
                                                      Editable="@(!_isSaved)"
                                                      ActivePhotographId="_activePhotographId"
                                                      ActivePhotographIdChanged="OnActivePhotographChanged"
                                                      OnRemovePhotograph="RemovePhotographAsync"
                                                      ShowSinglePhotographCount="true"
                                                      IdPrefix="catch" />
                        </div>
                        <MudTextField T="string"
                                      Value="_caughtOnLocal"
                                      ValueChanged="OnCaughtOnChanged"
                                      Label="@Loc["Catch_EditCaughtOn"]"
                                      Immediate="true"
                                      InputType="InputType.DateTimeLocal"
                                      Disabled="_isSaved"
                                      id="catch-caught-on" />
                        @if (ShowPhotographChooser && !_isSaved)
                        {
                            <MudAlert Severity="Severity.Warning" id="catch-photo-metadata-conflict">
                                @Loc["Catch_PhotoMetadataConflict"]
                            </MudAlert>
                            <PhotographDetails IdPrefix="catch"
                                               PhotographId="CurrentPhotograph?.Id"
                                               Metadata="CurrentPhotograph?.Metadata"
                                               CapturedOnLocal="@(CurrentPhotograph?.CapturedOnLocal)"
                                               ShowUseDetails="true"
                                               IsChosen="CurrentPhotographIsRepresentative"
                                               OnUseDetails="UseCurrentPhotographDetailsAsync" />
                        }
                        @if (_caughtOnInvalid)
                        {
                            <MudAlert Severity="Severity.Error" id="catch-caught-on-invalid">
                                @Loc["Catch_EditCaughtOnInvalid"]
                            </MudAlert>
                        }
                    }

                    @if (!_isSaved)
                    {
                        <PhotographPicker IdPrefix="catch"
                                          MaxPhotographs="MaxSelectedPhotographs"
                                          PhotographsPrepared="OnPhotographsPreparedAsync" />
                    }

                    <MudStack Row="true" Spacing="2" Class="record-catch-measurements">
                        <MeasurementField IsWeight="true"
                                          Value="_weight"
                                          ValueChanged="SetWeight"
                                          WeightUnit="Preferences.WeightUnit"
                                          LengthUnit="Preferences.LengthUnit"
                                          Id="record-catch-weight" />
                        <MeasurementField IsWeight="false"
                                          Value="_length"
                                          ValueChanged="SetLength"
                                          WeightUnit="Preferences.WeightUnit"
                                          LengthUnit="Preferences.LengthUnit"
                                          Id="record-catch-length" />
                    </MudStack>

                    @if ((PhotoLocationApplied || CoordinateConflict) && !_isSaved)
                    {
                        <MudStack Spacing="1" id="catch-location-photo-actions">
                            @if (PhotoLocationApplied)
                            {
                                <MudText Typo="Typo.caption"
                                         Color="Color.Success"
                                         id="catch-location-from-photo">
                                    @Loc["Catch_LocationFromPhoto"]
                                </MudText>
                            }
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="UseCurrentLocationAsync"
                                       id="catch-location-use-current">
                                @Loc["Catch_LocationUseCurrent"]
                            </MudButton>
                        </MudStack>
                    }
                    else if (!_isSaved && _locationPrompt.ShowExplainer)
                    {
                        <MudStack Spacing="1" id="catch-location-explainer">
                            <MudText Typo="Typo.caption">@Loc["Catch_LocationExplainer"]</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Catch_LocationPrivacy"]</MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="AllowLocationAsync"
                                           id="catch-location-allow">
                                    @Loc["Catch_LocationAllow"]
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="DismissLocationAsync"
                                           id="catch-location-not-now">
                                    @Loc["Catch_LocationNotNow"]
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    }
                    else if (!_isSaved && _locationPrompt.WillCaptureOnSave)
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Success"
                                 id="catch-location-status">
                            @Loc["Catch_LocationOnPrivate"]
                        </MudText>
                    }
                    else if (!_isSaved && _locationPrompt.ShowEnableLater)
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="AllowLocationAsync"
                                   id="catch-location-try-again">
                            @Loc["Catch_LocationTryAgain"]
                        </MudButton>
                    }

                    @if (ShowAnglerSelector)
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption">@Loc["Catch_AnglerLabel"]</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap" id="record-catch-angler-chips">
                                @foreach (var angler in AnglerOptions)
                                {
                                    var selected = angler.UserId == _selectedAnglerUserId;
                                    <MudChip T="string"
                                             Color="@(selected ? Color.Primary : Color.Default)"
                                             Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                             Disabled="_isSaved"
                                             OnClick="@(() => SelectAngler(angler.UserId))"
                                             id="@($"record-catch-angler-{angler.UserId:D}")">
                                        @angler.DisplayName
                                    </MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    }

                    @if (ShowTripAssociation)
                    {
                        <MudStack Row="true"
                                  Spacing="2"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween"
                                  Class="catch-trip-row"
                                  id="catch-trip-association">
                            <MudStack Row="true"
                                      Spacing="2"
                                      AlignItems="AlignItems.Center"
                                      Class="catch-trip-state">
                                <MudIcon Icon="@FishingLogBookIcons.FishingTrip"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         aria-hidden="true" />
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @Loc["Catch_TripRecordingIn"]
                                    </MudText>
                                    <MudText Typo="Typo.body2"
                                             Class="catch-trip-name"
                                             id="catch-trip-name">@_associatedTripLabel</MudText>
                                </MudStack>
                            </MudStack>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.LinkOff"
                                       OnClick="LeaveTrip"
                                       Class="catch-trip-action"
                                       id="catch-trip-leave">
                                @Loc["Catch_TripLeave"]
                            </MudButton>
                        </MudStack>
                    }
                    else if (ShowTripOptedOut)
                    {
                        <MudStack Row="true"
                                  Spacing="2"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween"
                                  Class="catch-trip-row"
                                  id="catch-trip-standalone-row">
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary"
                                     id="catch-trip-standalone">
                                @Loc["Catch_TripNotPartOfTrip"]
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       StartIcon="@FishingLogBookIcons.FishingTrip"
                                       OnClick="RejoinTripAsync"
                                       Class="catch-trip-action"
                                       id="catch-trip-rejoin">
                                @Loc["Catch_TripRejoin"]
                            </MudButton>
                        </MudStack>
                    }

                    @if (_tripUnavailable)
                    {
                        <MudAlert Severity="Severity.Warning" id="catch-trip-unavailable">
                            @Loc["Catch_TripUnavailable"]
                        </MudAlert>
                    }

                    @if (_isSaved)
                    {
                        <MudAlert Severity="Severity.Success" id="catch-saved">@Loc["Catch_Saved"]</MudAlert>
                        <MudText Typo="Typo.caption" id="catch-sync-saved-locally">
                            @Loc["SyncStatus_SavedLocally"]
                        </MudText>
                        @if (_locationSaved)
                        {
                            <MudText Typo="Typo.caption" id="catch-location-saved">@Loc["Catch_LocationSaved"]</MudText>
                        }
                    }

                    @if (_saveFailed)
                    {
                        <MudAlert Severity="Severity.Error" id="catch-save-failed">@Loc["Catch_SaveFailed"]</MudAlert>
                    }

                    @if (_isSaved)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   OnClick="RecordAnotherCatch"
                                   id="catch-record-another">
                            @Loc["Catch_RecordAnother"]
                        </MudButton>
                        @if (SavedTripHref is { } savedTripHref)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Href="@savedTripHref"
                                       StartIcon="@FishingLogBookIcons.FishingTrip"
                                       id="catch-view-trip">
                                @Loc["Trip_ViewTrip"]
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Href="@ViewCatchesHref"
                                   id="catch-view-catches">
                            @Loc["Catch_ViewCatches"]
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="@(!CanSave)"
                                   OnClick="SaveAsync"
                                   id="save-catch-button">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Size="Size.Small"
                                                     Indeterminate="true"
                                                     Class="ms-n1 mr-2"
                                                     id="save-catch-spinner" />
                                @Loc["Catch_Saving"]
                            }
                            else
                            {
                                @Loc["Catch_Save"]
                            }
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>
