@page "/offline/catches/{CatchId:guid}/edit"
@attribute [OfflineRoute]
@layout OfflineLayout
@using FishingLogBook.Web.Features.Catch.Components.CatchEditEditor
@using FishingLogBook.Web.Features.OfflineAccess

<PageTitle>@Loc["Catch_EditPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudText Typo="Typo.h4" Align="Align.Center" id="offline-catch-edit-title">@Loc["Catch_EditTitle"]</MudText>
        @if (_accessLocked)
        {
            <MudAlert Severity="Severity.Info" id="offline-catch-edit-access-locked">@Loc["OfflineAccess_UnlockFailed"]</MudAlert>
        }
        else if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="offline-catch-edit-load-failed">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Justify="Justify.SpaceBetween">
                    <span>@Loc["Catch_EditLoadFailed"]</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               OnClick="RetryLoadAsync" Disabled="_isLoading"
                               id="offline-catch-edit-load-retry">@Loc["Catch_LoadRetry"]</MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center" id="offline-catch-edit-loading" />
        }
        else if (_catch is not null)
        {
            <MudExpansionPanels Elevation="1" MultiExpansion="true" id="offline-catch-edit-photo-sections">
                <MudExpansionPanel Text="@Loc["Catch_EditPhotographsSection"]" Expanded="true">
                    <PhotographCarousel Photographs="CarouselPhotographs" Editable="false" IdPrefix="offline-catch-edit" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            <CatchEditEditor Catch="_catch"
                             Preferences="_preferences"
                             IdPrefix="offline-catch-edit"
                             Saved="OnSavedAsync"
                             BindingFailed="OnEditorBindingFailed" />
        }
    </MudStack>
</MudContainer>
