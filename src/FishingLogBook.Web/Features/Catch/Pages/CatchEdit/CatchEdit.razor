@page "/catches/{CatchId:guid}/edit"
@using Microsoft.AspNetCore.Authorization
@using FishingLogBook.Shared.Constants
@attribute [Authorize]

<PageTitle>@Loc["Catch_EditPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudText Typo="Typo.h4" Align="Align.Center" id="catch-edit-title">
            @Loc["Catch_EditTitle"]
        </MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mud-text-secondary">
            @Loc["Catch_EditSubtitle"]
        </MudText>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="catch-edit-load-failed">
                @(_offlineUnavailable ? Loc["Catch_EditLoadOfflineFailed"] : Loc["Catch_EditLoadFailed"])
            </MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center"
                                 id="catch-edit-loading" />
        }
        else
        {
            @if (_catalogueUnavailable)
            {
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary"
                         id="catch-edit-catalogue-unavailable">
                    @Loc["Catch_CatalogueUnavailable"]
                </MudText>
            }

            <MudExpansionPanels Elevation="1" MultiExpansion="true" id="catch-edit-sections">
                <MudExpansionPanel Text="@Loc["Catch_EditPhotographsSection"]"
                                   Expanded="true"
                                   id="catch-edit-photos-panel">
                    <MudStack Spacing="2">
                        <CatchPhotographCarousel Photographs="CarouselPhotographs"
                                                  Editable="true"
                                                  IdPrefix="catch-edit"
                                                  OnRemovePhotograph="OnRemovePhotographAsync" />

                        <div class="catch-edit-photo-actions">
                            <label for="catch-edit-photo-camera"
                                   class="catch-edit-photo-picker catch-edit-photo-picker-primary"
                                   id="catch-edit-take-photo">
                                @Loc["Catch_TakePhoto"]
                            </label>
                            <label for="catch-edit-photo-gallery"
                                   class="catch-edit-photo-picker catch-edit-photo-picker-secondary"
                                   id="catch-edit-choose-photo">
                                @Loc["Catch_ChoosePhoto"]
                            </label>
                            <InputFile OnChange="OnAddPhotographsSelected"
                                       accept="image/*"
                                       capture="environment"
                                       class="catch-edit-photo-input"
                                       id="catch-edit-photo-camera" />
                            <InputFile OnChange="OnAddPhotographsSelected"
                                       accept="image/*"
                                       multiple
                                       class="catch-edit-photo-input"
                                       id="catch-edit-photo-gallery" />
                        </div>

                        @if (_unsupportedFormat)
                        {
                            <MudAlert Severity="Severity.Error" id="catch-edit-photo-unsupported">
                                @Loc["Catch_PhotoUnsupported"]
                            </MudAlert>
                        }

                        @if (_cannotRemoveLastPhoto)
                        {
                            <MudAlert Severity="Severity.Warning" id="catch-edit-photo-last">
                                @Loc["Catch_EditCannotRemoveLastPhoto"]
                            </MudAlert>
                        }

                        @if (_addPhotoFailed || _removePhotoFailed)
                        {
                            <MudAlert Severity="Severity.Error" id="catch-edit-photo-action-failed">
                                @Loc["Catch_EditPhotoActionFailed"]
                            </MudAlert>
                        }
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["Catch_EditDetailsSection"]"
                                   Expanded="true"
                                   id="catch-edit-details-panel">
                    <MudStack Spacing="4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption">@Loc["Catch_EditMethod"]</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap" id="catch-edit-method-chips">
                                @foreach (var method in MethodOptions)
                                {
                                    var selected = string.Equals(method.Name, _method, StringComparison.OrdinalIgnoreCase);
                                    <MudChip T="string"
                                             Color="@(selected ? Color.Primary : Color.Default)"
                                             Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                             OnClick="@(() => SelectMethod(method.Name))"
                                             id="@($"catch-edit-method-{method.Code}")">
                                        @method.Name
                                    </MudChip>
                                }
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           OnClick="ChooseMethodAsync"
                                           id="catch-edit-method-more">
                                    @Loc["Common_More"]
                                </MudButton>
                            </MudStack>
                            <MudTextField @bind-Value="MethodInput"
                                          Label="@Loc["Catch_EditMethod"]"
                                          MaxLength="@CatchDetailConstants.MaxMethodLength"
                                          Immediate="true"
                                          id="catch-edit-method" />
                        </MudStack>

                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption">@Loc["Catch_EditSpecies"]</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap" id="catch-edit-species-chips">
                                @foreach (var species in SpeciesOptions)
                                {
                                    var selected = string.Equals(species.Name, _speciesName, StringComparison.OrdinalIgnoreCase);
                                    <MudChip T="string"
                                             Color="@(selected ? Color.Primary : Color.Default)"
                                             Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                             OnClick="@(() => SelectSpecies(species.Name))"
                                             id="@($"catch-edit-species-{species.Code}")">
                                        @species.Name
                                    </MudChip>
                                }
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           OnClick="ChooseSpeciesAsync"
                                           id="catch-edit-species-more">
                                    @Loc["Common_More"]
                                </MudButton>
                            </MudStack>
                            <MudTextField @bind-Value="SpeciesInput"
                                          Label="@Loc["Catch_EditSpecies"]"
                                          MaxLength="@CatchDetailConstants.MaxSpeciesNameLength"
                                          Immediate="true"
                                          id="catch-edit-species" />
                        </MudStack>

                        <MudTextField @bind-Value="_weightText"
                                      Label="@WeightLabel"
                                      Immediate="true"
                                      InputType="InputType.Number"
                                      id="catch-edit-weight" />

                        <MudTextField @bind-Value="_lengthText"
                                      Label="@LengthLabel"
                                      Immediate="true"
                                      InputType="InputType.Number"
                                      id="catch-edit-length" />

                        <MudTextField @bind-Value="_baitOrLure"
                                      Label="@Loc["Catch_EditBaitOrLure"]"
                                      MaxLength="@CatchDetailConstants.MaxBaitOrLureLength"
                                      Immediate="true"
                                      id="catch-edit-bait" />
                        <MudTextField @bind-Value="_notes"
                                      Label="@Loc["Catch_EditNotes"]"
                                      MaxLength="@CatchDetailConstants.MaxNotesLength"
                                      Immediate="true"
                                      Lines="4"
                                      id="catch-edit-notes" />
                        <MudTextField @bind-Value="_caughtOnLocal"
                                      Label="@Loc["Catch_EditCaughtOn"]"
                                      Immediate="true"
                                      InputType="InputType.DateTimeLocal"
                                      id="catch-edit-caught-on" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["Catch_ManageLocationPrivacy"]"
                                   id="catch-edit-location-panel">
                    @if (_catch?.Location is null)
                    {
                        <MudText Typo="Typo.body2" id="catch-edit-location-none">
                            @Loc["Catch_LocationPrivacyNoLocation"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" id="catch-edit-location-visibility">
                                @LocationVisibilityLabel
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="OpenLocationPrivacyAsync"
                                       id="catch-edit-location-manage">
                                @Loc["Catch_ManageLocationPrivacy"]
                            </MudButton>
                        </MudStack>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_validationMessage is not null)
            {
                <MudAlert Severity="Severity.Warning" id="catch-edit-validation">
                    @_validationMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_isSaving"
                       OnClick="SaveAsync"
                       id="catch-edit-save">
                @(_isSaving ? Loc["Catch_EditSaving"] : Loc["Catch_EditSave"])
            </MudButton>

            @if (_saveFailed)
            {
                <MudAlert Severity="Severity.Error" id="catch-edit-save-failed">
                    @Loc["Catch_EditSaveFailed"]
                </MudAlert>
            }

            @if (_saved)
            {
                <MudAlert Severity="Severity.Success" id="catch-edit-saved">
                    @Loc["Catch_EditSaved"]
                </MudAlert>
            }
        }
    </MudStack>
</MudContainer>
