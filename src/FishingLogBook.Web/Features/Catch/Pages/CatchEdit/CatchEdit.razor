@page "/catches/{CatchId:guid}/edit"
@using Microsoft.AspNetCore.Authorization
@using FishingLogBook.Web.Features.Catch.Components.CatchEditEditor
@using FishingLogBook.Web.Features.Catch.Components.CatchProvenanceEditor
@attribute [Authorize]

<PageTitle>@Loc["Catch_EditPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudText Typo="Typo.h4" Align="Align.Center" id="catch-edit-title">@Loc["Catch_EditTitle"]</MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mud-text-secondary">@Loc["Catch_EditSubtitle"]</MudText>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="catch-edit-load-failed">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Justify="Justify.SpaceBetween">
                    <span>@(_offlineUnavailable ? Loc["Catch_EditLoadOfflineFailed"] : Loc["Catch_EditLoadFailed"])</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               OnClick="RetryLoadAsync" Disabled="_isLoading"
                               id="catch-edit-load-retry">@Loc["Catch_LoadRetry"]</MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center" id="catch-edit-loading" />
        }
        else if (_catch is not null)
        {
            @if (!_preferences.HasCatalogue)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary" id="catch-edit-catalogue-unavailable">@Loc["Catch_CatalogueUnavailable"]</MudText>
            }

            <CatchProvenanceEditor CatchId="_catch.Id" TripId="_catch.TripId" />

            <MudExpansionPanels Elevation="1" MultiExpansion="true" id="catch-edit-photo-sections">
                <MudExpansionPanel Text="@Loc["Catch_EditPhotographsSection"]" Expanded="true" id="catch-edit-photos-panel">
                    <MudStack Spacing="2">
                        <PhotographCarousel Photographs="CarouselPhotographs"
                                            Editable="true"
                                            IdPrefix="catch-edit"
                                            ActivePhotographId="_activePhotographId"
                                            ActivePhotographIdChanged="OnActivePhotographChangedAsync"
                                            OnRemovePhotograph="OnRemovePhotographAsync" />
                        @if (ShowPhotographDetails)
                        {
                            <PhotographDetails IdPrefix="catch-edit"
                                               PhotographId="CurrentPreparedPhotograph?.Id"
                                               Metadata="CurrentPreparedPhotograph?.Metadata"
                                               CapturedOnLocal="@(CurrentPreparedPhotograph?.CapturedOnLocal)"
                                               ShowUseDetails="true"
                                               IsChosen="CurrentPhotographIsApplied"
                                               OnUseDetails="UseCurrentPhotographDetailsAsync" />
                        }
                        <PhotographPicker IdPrefix="catch-edit"
                                          PhotographsPrepared="OnPhotographsPreparedAsync" />
                        @if (_cannotRemoveLastPhoto)
                        {
                            <MudAlert Severity="Severity.Warning" id="catch-edit-photo-last">@Loc["Catch_EditCannotRemoveLastPhoto"]</MudAlert>
                        }
                        @if (_addPhotoFailed || _removePhotoFailed)
                        {
                            <MudAlert Severity="Severity.Error" id="catch-edit-photo-action-failed">@Loc["Catch_EditPhotoActionFailed"]</MudAlert>
                        }
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <CatchEditEditor @ref="_editor"
                             Catch="_catch"
                             Preferences="_preferences"
                             AppliedLocation="_appliedLocation"
                             IdPrefix="catch-edit"
                             Saved="OnDetailsSavedAsync"
                             BindingFailed="OnEditorBindingFailed" />

            <MudExpansionPanels Elevation="1" MultiExpansion="true" id="catch-edit-location-sections">
                <MudExpansionPanel Text="@Loc["Catch_ManageLocationPrivacy"]" id="catch-edit-location-panel">
                    @if (_catch.Location is null)
                    {
                        <MudText Typo="Typo.body2" id="catch-edit-location-none">@Loc["Catch_LocationPrivacyNoLocation"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" id="catch-edit-location-visibility">@LocationVisibilityLabel</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenLocationPrivacyAsync" id="catch-edit-location-manage">@Loc["Catch_ManageLocationPrivacy"]</MudButton>
                        </MudStack>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
</MudContainer>
