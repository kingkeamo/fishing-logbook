@page "/catches"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@Loc["Catch_LogbookPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="catch-list-container pa-4">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" Align="Align.Center">@Loc["Catch_LogbookTitle"]</MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mud-text-secondary">@Loc["Catch_LogbookSubtitle"]</MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Href="/catches/record"
                   id="catch-record-link">
            @Loc["Catch_RecordNav"]
        </MudButton>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="catch-list-load-failed">@Loc["Catch_LoadFailed"]</MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center" id="catch-list-loading" />
        }
        else if (_catches.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center" id="catch-list-empty">@Loc["Catch_LogbookEmpty"]</MudText>
        }
        else
        {
            <MudStack Spacing="3" id="catch-list">
                @foreach (var catchRecord in _catches)
                {
                    var thumbnail = catchRecord.Photographs.FirstOrDefault();
                    <MudPaper Class="pa-3" Elevation="2" id="@($"catch-row-{catchRecord.Id:D}")">
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                            @if (thumbnail?.Bytes is { Length: > 0 })
                            {
                                <img src="@ThumbnailUrl(thumbnail)"
                                     alt="@Loc["Catch_PhotographAlt"]"
                                     class="catch-list-thumbnail"
                                     id="@($"catch-thumb-{catchRecord.Id:D}")" />
                            }
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle1" id="@($"catch-label-{catchRecord.Id:D}")">
                                    @SpeciesLabel(catchRecord.SpeciesName)
                                </MudText>
                                <MudText Typo="Typo.caption" id="@($"catch-time-{catchRecord.Id:D}")">
                                    @catchRecord.CaughtOn.ToString("g")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudStack>
</MudContainer>
