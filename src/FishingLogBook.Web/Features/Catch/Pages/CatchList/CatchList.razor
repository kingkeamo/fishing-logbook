@using FishingLogBook.Web.Common.Icons
@page "/catches"
@using Microsoft.AspNetCore.Authorization
@using FishingLogBook.Web.Features.Catch.Components.CatchCard
@using FishingLogBook.Web.Features.Catch.Components.CatchFilters
@attribute [Authorize]

<PageTitle>@Loc["Catch_LogbookPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Gutters="false" Class="catch-list-container">
    <MudStack Spacing="4" AlignItems="AlignItems.Stretch">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
            <MudText Typo="Typo.h4" id="catch-list-title">@Loc["Catch_LogbookTitle"]</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Width="9rem"
                                 Height="2.25rem"
                                 id="trip-action-loading" />
                }
                else if (_activeTrip is not null)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Href="@ActiveTripHref"
                               StartIcon="@FishingLogBookIcons.FishingTrip"
                               id="trip-update-link">
                        @Loc["Trip_Update"]
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="StartFishingAsync"
                               Disabled="_isStartingTrip"
                               StartIcon="@FishingLogBookIcons.FishingTrip"
                               id="trip-start-link">
                        @Loc["Trip_StartFishing"]
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/catches/record"
                           StartIcon="@Icons.Material.Filled.AddAPhoto"
                           Class="catch-record-cta"
                           id="catch-record-link">
                    @Loc["Catch_RecordNav"]
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" id="catch-list-load-failed">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Justify="Justify.SpaceBetween">
                    <span>@Loc["Catch_LoadFailed"]</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               OnClick="RetryLoadAsync" Disabled="_isLoadInFlight"
                               id="catch-list-load-retry">@Loc["Catch_LoadRetry"]</MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="align-self-center" id="catch-list-loading" />
        }
        else if (_allCatches.Count == 0)
        {
            <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="catch-list-empty-state" id="catch-list-empty">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Class="mud-text-secondary" aria-hidden="true" />
                <MudText Typo="Typo.body1" Align="Align.Center">@Loc["Catch_LogbookEmpty"]</MudText>
            </MudStack>
        }
        else
        {
            <CatchFilters Filters="_filters"
                          FiltersChanged="OnFiltersChanged"
                          MethodOptions="_methodOptions"
                          SpeciesOptions="_speciesOptions" />

            @if (_filteredGroups.Count == 0)
            {
                <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="catch-list-empty-state" id="catch-list-no-matches">
                    <MudText Typo="Typo.body1" Align="Align.Center">@Loc["Catch_NoSearchResults"]</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="ClearFilters"
                               id="catch-list-clear-filters">
                        @Loc["Catch_ClearSearchOrFilters"]
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudStack Spacing="4" id="catch-list">
                    @foreach (var group in _filteredGroups)
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary catch-group-header">
                                @group.Header
                            </MudText>
                            <MudGrid Spacing="2">
                                @foreach (var catchRecord in group.Catches)
                                {
                                    <MudItem xs="12" md="6">
                                        <CatchCard Catch="catchRecord"
                                                   LocalCaughtOn="@LocalDateTime(catchRecord.Id)"
                                                   LocalToday="_localToday"
                                                   WeightUnit="_weightUnit"
                                                   LengthUnit="_lengthUnit"
                                                   CurrentUserId="_currentUserId"
                                                   IsRetrying="_retrying.Contains(catchRecord.Id)"
                                                   OnRetry="RetryAsync"
                                                   OnLocationPrivacy="OpenLocationPrivacyAsync" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    }
                </MudStack>
            }
        }
    </MudStack>
</MudContainer>
