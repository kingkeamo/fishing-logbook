@page "/catches/record"
@attribute [Authorize]
@using FishingLogBook.Web.Features.Catch.Components.RecordCatchEditor

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" id="record-catch-loading" />
}
else
{
    <RecordCatchEditor OwnerUserId="_ownerUserId"
                       Preferences="_preferences"
                       Saved="OnSavedAsync" />
}
