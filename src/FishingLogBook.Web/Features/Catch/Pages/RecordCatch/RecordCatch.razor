@page "/catches/record"
@attribute [Authorize]
@using FishingLogBook.Web.Features.Catch.Components.RecordCatchEditor

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" id="record-catch-loading" />
}
else
{
    @if (_ownerResolutionFailed)
    {
        <MudAlert Severity="Severity.Error" id="record-catch-owner-failed">
            @Loc["Catch_RecordOwnerUnavailable"]
        </MudAlert>
    }
    else
    {
        <RecordCatchEditor OwnerUserId="_ownerUserId"
                           Preferences="_preferences"
                           RequestedTripId="TripId"
                           AnglerOptions="_anglerOptions"
                           OnTripAssociated="OnTripAssociatedAsync"
                           Saved="OnSavedAsync" />
    }
}
