@using Microsoft.AspNetCore.Components.Authorization
@using FishingLogBook.Web.Features.Authentication.Components.RedirectToLogin
@using FishingLogBook.Web.Features.OfflineAccess.Components.OfflineRouteView

<AppErrorBoundary>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(FishingLogBook.Web.Pages.NotFound.NotFound)">
        <Found Context="routeData">
            @if (IsOfflineRoute(routeData.PageType))
            {
                <OfflineRouteView RouteData="routeData" />
            }
            else if (IsPublicRoute(routeData.PageType))
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            }
            else
            {
                <CascadingAuthenticationState>
                    @if (routeData.PageType == typeof(FishingLogBook.Web.Features.Onboarding.Pages.Landing.Landing))
                    {
                        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                    }
                    else
                    {
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized>
                                <RedirectToLogin />
                            </NotAuthorized>
                        </AuthorizeRouteView>
                    }
                </CascadingAuthenticationState>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</AppErrorBoundary>
